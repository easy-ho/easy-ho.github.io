---
import { getCollection } from 'astro:content';
import { categorySlug, categoryOrder } from '../consts';
interface Props { current?: string }
const { current } = Astro.props;
const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const cats = [...counts.keys()].sort((a, b) => categoryOrder(a) - categoryOrder(b) || a.localeCompare(b));
---
<p class="cats">
	<a href="/blog/" class:list={{ active: !current }}>전체 <span>{posts.length}</span></a>
	{cats.map((c) => (
		<a href={`/category/${categorySlug(c)}/`} class:list={{ active: c === current }}>{c} <span>{counts.get(c)}</span></a>
	))}
</p>
