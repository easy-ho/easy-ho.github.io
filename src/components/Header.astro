---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">글</HeaderLink>
			<HeaderLink href="/about">소개</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header { max-width: 660px; margin: 0 auto; padding: 1.5rem 1.25rem 0; }
	nav { display: flex; justify-content: space-between; align-items: baseline; }
	.brand { font-weight: 700; text-decoration: none; font-size: 1.05rem; }
	.links { display: flex; gap: 1.2em; font-size: 0.95rem; }
	.links a { text-decoration: none; color: var(--muted); }
	.links a:hover, .links a.active { color: var(--text); }
</style>
