---
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 섬 = 다녀온 회사. 회사명은 쓰지 않는다. 항로는 시간순이고, 첫 섬에는 두 번 머물렀다.
// 방문자는 첫 섬에서 출항해 시간순으로 항로를 따라간다. 닿을 때마다 등대가 켜지고 지나온 길이 그려진다.
const islands = [
	{ id: 'A', x: -48, y: -46, r: 3.6, seed: 2, title: '영양제 추천 스타트업', date: '2018.08 – 2021.09 · 2022.02 – 2024.10', body: '첫 번째 개발자로 입사해 추천 알고리즘과 결제·주문·백오피스를 만들어 서비스를 띄웠고, 모놀리식을 MSA로 쪼개고 배포 자동화와 로그를 깔았다. 한 번 떠났다가 돌아와서는 쇼핑몰 리뉴얼을 리드했다. 실시간 채팅 상담, CDC 동기화, 검색, 멀티테넌시.' },
	{ id: 'B', x: -14, y: -62, r: 2.6, seed: 5, title: 'K-pop 팬 플랫폼', date: '2021.09 – 2022.02', body: '음악 방송 생방송 투표가 몰리는 순간의 트래픽을 다뤘다. 좋아요·맞춤 데이터에 Redis 캐시, AWS 약정 만료를 미리 알려주는 배치. 짧게 들렀다가 첫 섬으로 되돌아갔다.' },
	{ id: 'C', x: -58, y: -4, r: 2.4, seed: 8, title: '의료 플랫폼', date: '2024.12 – 2025.02', body: '병원 SaaS와 환자 앱을 위한 통합 인증을 Keycloak 기반 멀티테넌시로 설계했다. 석 달 머문 작은 섬.' },
	{ id: 'D', x: -22, y: 24, r: 3.9, seed: 7, title: '웹툰 플랫폼 · 지금 정박 중', date: '2025.04 –', body: '게이미피케이션 서버와 실시간 이벤트 서버를 새로 설계해 운영하고, 가장 많이 불리는 뷰어 API를 분리하고, 추천 파이프라인을 깔았다. 아직 여기 묶여 있는 배. 다음 섬은 모른다.' },
];
const route = ['A', 'B', 'A', 'C', 'D'].map((id) => islands.find((I) => I.id === id)!);
const cur = route[route.length - 1];
const SAIL_FROM = '2018-08-01';
// 유리병 편지 = 개발 가치관. 그 시절 항로 위에 떠 있다. leg = 구간 번호, t = 구간 위 위치, s = 항로에서 옆으로 벗어난 거리.
const values = [
	{ id: 'b2', leg: 0, t: 0.32, s: -2.5, text: '기능 하나보다 플랫폼을 만들고 넓히는 문제를 좋아한다. 도메인이 늘어도 다시 만들지 않는 계층.' },
	{ id: 'b4', leg: 0, t: 0.68, s: 2.5, text: '장애는 추측하지 않는다. 재현 실험으로 원인을 특정한다.' },
	{ id: 'b5', leg: 1, t: 0.5, s: -2.5, text: '요청이 한순간에 몰리는 이벤트에서도 정원·보상·판정이 어긋나지 않게. 원자 연산과 멱등이 기본.' },
	{ id: 'b3', leg: 2, t: 0.48, s: 2.5, text: '모든 변경은 산식으로 먼저 계산하고 실측으로 확인한 뒤 반영한다.' },
	{ id: 'b6', leg: 3, t: 0.34, s: -2.5, text: 'AI는 서비스에도 쓰고 일하는 방식에도 쓴다. 이 블로그와 이 바다도 Claude Code와 같이 만들었다.' },
	{ id: 'b1', leg: 3, t: 0.68, s: 2.5, text: '8년 차 백엔드. Kotlin·Java(Spring, WebFlux)와 Python 사이를 오간다.' },
].map((b) => { const a = route[b.leg], c = route[b.leg + 1], dx = c.x - a.x, dy = c.y - a.y, L = Math.hypot(dx, dy); return { id: b.id, kind: 1, text: b.text, x: a.x + dx * b.t - (dy / L) * b.s, y: a.y + dy * b.t + (dx / L) * b.s }; });
// 일지 유리병 = 블로그 글. 지금 섬 앞바다에 떠 있다. 새 글이 올라오면 하나 더. 위치는 글 id 해시.
const hash = (t: string) => { let h = 2166136261; for (const c of t) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; } return h; };
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const logs = posts.map((p) => {
	const h = hash(p.id), a = (h % 360) * Math.PI / 180, r = cur.r * 1.25 + 5.5 + ((h >>> 9) % 6);
	return { id: `log-${p.id}`, x: cur.x + Math.cos(a) * r, y: cur.y + Math.sin(a) * r, kind: 2, title: p.data.title, date: p.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.'), href: `/blog/${p.id}/` };
});
const bottles = [...values, ...logs];
const hasCv = existsSync('public/cv.pdf');
// 선실에 걸어둘 것. 책은 비워두면 안 보인다.
const captain = { reading: '', now: ['이 바다와 카드팩을 Claude Code와 같이 만드는 중', 'Kotlin · WebFlux · Redis · Kafka 위에서 실시간 서버를 굴리는 중'] };
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`항해 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			html, body { height: 100%; overflow: hidden; background: #0b2a36; }
			#gl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: crosshair; }
			.hud { position: fixed; inset: 0; pointer-events: none; color: #fff; text-shadow: 0 1px 2px rgba(0,20,30,0.6), 0 0 14px rgba(0,20,30,0.5); }
			.hud .top { position: absolute; top: calc(1.2rem + env(safe-area-inset-top, 0px)); left: 1.25rem; right: 1.25rem; display: flex; justify-content: space-between; align-items: baseline; } .hud .top a { pointer-events: auto; }
			.hud .brand { font-weight: 700; text-decoration: none; font-size: 1.05rem; color: inherit; }
			.hud .links { display: flex; gap: 1.2em; font-size: 0.95rem; } .hud .links a { text-decoration: none; color: inherit; opacity: 0.85; }
			.intro { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; transition: opacity 0.5s; padding: 0 1.25rem; }
			.intro h1 { font-size: clamp(2.4rem, 7vw, 4rem); letter-spacing: -0.03em; margin: 0 0 0.2em; font-weight: 800; }
			.intro p { margin: 0; opacity: 0.9; line-height: 1.6; }
			.intro .go { margin-top: 2em; font-family: var(--mono); font-size: 0.85rem; opacity: 0.9; animation: pulse 1.6s ease-in-out infinite; }
			@keyframes pulse { 50% { opacity: 0.3; } }
			.intro.off { opacity: 0; }
			.near { position: absolute; left: 50%; bottom: 16%; transform: translateX(-50%); width: min(92vw, 520px); text-align: center; opacity: 0; transition: opacity 0.3s; }
			.near.on { opacity: 1; }
			.near .k { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.2em; opacity: 0.85; }
			.near .t { display: block; font-size: clamp(1.2rem, 3.4vw, 1.7rem); font-weight: 800; letter-spacing: -0.02em; text-decoration: none; color: inherit; margin-top: 0.2em; }
			.near .d { font-family: var(--mono); font-size: 0.85rem; opacity: 0.85; margin-top: 0.3em; }
			.near .p { font-size: 0.95rem; line-height: 1.65; margin: 0.8em 0 0; background: rgba(0,20,30,0.45); border-radius: 10px; padding: 0.8em 1em; text-shadow: none; backdrop-filter: blur(4px); }
			.near .p:empty { display: none; }
			.mirage, .next { position: absolute; left: 0; top: 0; font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.15em; opacity: 0; transition: opacity 0.6s; translate: -50% -50%; white-space: nowrap; }
			.mirage.on { opacity: 0.55; animation: pulse 3s ease-in-out infinite; }
			.next.on { opacity: 0.8; }
			.next i { display: inline-block; font-style: normal; margin-right: 0.4em; }
			.toast { position: absolute; left: 50%; top: 18%; transform: translateX(-50%); width: min(90vw, 460px); background: rgba(0,20,30,0.55); backdrop-filter: blur(6px); border-radius: 12px; padding: 0.9em 1.1em; font-size: 0.95rem; line-height: 1.6; text-shadow: none; opacity: 0; transition: opacity 0.4s, translate 0.4s; translate: 0 8px; }
			.toast.on { opacity: 1; translate: 0 0; }
			.toast .k { display: block; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.2em; opacity: 0.8; margin-bottom: 0.4em; }
			.toast a { color: #fde68a; font-family: var(--mono); font-size: 0.82rem; margin-left: 0.6em; pointer-events: auto; }
			.cabin { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(2,10,14,0.55); backdrop-filter: blur(3px); opacity: 0; pointer-events: none; transition: opacity 0.35s; text-shadow: none; }
			.cabin.on { opacity: 1; pointer-events: auto; }
			.cabin .room { width: min(92vw, 560px); max-height: 86vh; overflow: auto; background: linear-gradient(160deg, #3a2a1e, #1f1611); border: 1px solid rgba(255,220,160,0.25); border-radius: 14px; padding: 1.4rem 1.5rem; box-shadow: 0 30px 80px rgba(0,0,0,0.6); color: #f3e9d6; transform: scale(0.96); transition: transform 0.35s; }
			.cabin.on .room { transform: none; }
			.cabin h2 { margin: 0; font-size: 1.3rem; letter-spacing: -0.02em; }
			.cabin .k { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.2em; opacity: 0.7; margin: 1.3em 0 0.4em; }
			.cabin p { margin: 0; line-height: 1.65; font-size: 0.95rem; }
			.cabin ul { margin: 0; padding-left: 1.1em; line-height: 1.7; font-size: 0.95rem; }
			.cabin a { color: #fde68a; }
			.cabin .row { display: flex; gap: 0.6em; flex-wrap: wrap; margin-top: 0.4em; }
			.cabin .row a, .cabin .row span { font-family: var(--mono); font-size: 0.82rem; padding: 0.35em 0.9em; border: 1px solid rgba(255,220,160,0.4); border-radius: 999px; text-decoration: none; color: inherit; }
			.cabin .x { position: absolute; right: 1rem; top: 0.8rem; background: none; border: 0; color: inherit; font-size: 1.4rem; cursor: pointer; }
			.cabin .room { position: relative; }
			.help { position: absolute; left: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.85; }
			.stat { position: absolute; right: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.85; text-align: right; }
			/* 지도 */
			.map { position: absolute; right: 1.25rem; top: calc(4.2rem + env(safe-area-inset-top, 0px)); width: 150px; height: 150px; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.35); box-shadow: 0 10px 30px rgba(0,0,0,0.4); pointer-events: auto; cursor: pointer; transition: width 0.3s, height 0.3s; background: #061a22; }
			.map canvas { width: 100%; height: 100%; display: block; }
			.map .z { position: absolute; left: 6px; bottom: 4px; font-family: var(--mono); font-size: 0.68rem; opacity: 0.8; }
			.map.big { width: min(92vw, 560px); height: min(92vw, 560px); right: 50%; top: 50%; translate: 50% -50%; }
			@media (max-width: 700px) { .map { width: 110px; height: 110px; } .near { bottom: 22%; } .help { bottom: calc(2.9rem + env(safe-area-inset-bottom, 0px)); } }
			.fallback { max-width: 660px; margin: 4rem auto; padding: 0 1.25rem; display: none; color: #e5e7eb; }
		</style>
	</head>
	<body>
		<canvas id="gl"></canvas>
		<div class="hud" id="hud">
			<div class="top"><a class="brand" href="/">{SITE_TITLE}</a><div class="links"><a href="/blog">글</a><a href="/about">소개</a></div></div>
			<div class="intro" id="intro"><div><h1>easyho.log</h1><p id="ip"></p><div class="go">바다를 눌러 출항</div></div></div>
			<div class="near" id="near"><div class="k">ISLAND · 항해일지</div><div class="t" id="nt"></div><div class="d" id="nd"></div><p class="p" id="np"></p></div>
			<div class="mirage" id="mirage">다음 섬 ?</div>
			<div class="next" id="next"><i>➤</i>다음 섬</div>
			<div class="toast" id="toast"><span class="k" id="tk"></span><span id="tt"></span><a id="ta" href="#" hidden>읽기 →</a></div>
			<div class="map" id="map"><canvas id="mc"></canvas><div class="z" id="mz">M · 크게</div></div>
			<div class="help">클릭 · 터치로 항해 · 배를 두 번 누르면 선실</div>
			<div class="stat" id="stat"></div>
			<div class="cabin" id="cabin"><div class="room">
				<button class="x" id="cx" aria-label="닫기">×</button>
				<h2>선실</h2>
				<div class="k">CAPTAIN</div>
				<p>8년 차 백엔드. 웹툰 플랫폼에서 뷰어·추천·게이미피케이션·실시간 서버를 만든다. 스타트업의 첫 번째 개발자로 시작해 런칭, MSA 전환, 리뉴얼까지 한 바퀴 돌아봤다. 요청이 한순간에 몰려도 정원·보상·판정이 어긋나지 않게 하는 일을 좋아한다.</p>
				<div class="row"><a href="mailto:dev.easyho@gmail.com">dev.easyho@gmail.com</a>{hasCv && <a href="/cv.pdf">이력서 PDF</a>}</div>
				<div class="k">건진 유리병</div>
				<ul id="vals"></ul>
				<div class="k">NOW</div>
				<ul>{captain.now.map((n) => <li>{n}</li>)}{captain.reading && <li>읽는 책 · {captain.reading}</li>}</ul>
				<div class="k">주운 일지</div>
				<ul id="logs"></ul>
				<div class="k">LOG</div>
				<p id="clog"></p>
			</div></div>
		</div>
		<div class="fallback" id="fallback"><ul class="post-list">{islands.map((m) => <li><span>{m.date}</span>{m.title}</li>)}</ul></div>
		<script define:vars={{ islands, routeIds: route.map((I) => I.id), bottles, SAIL_FROM }}>
			const canvas = document.getElementById('gl');
			const gl = canvas.getContext('webgl2', { antialias: false, alpha: false });
			if (!gl) { document.getElementById('fallback').style.display = 'block'; document.getElementById('hud').style.display = 'none'; canvas.remove(); document.body.style.overflow = 'auto'; }
			else {
				const MAXI = 8, MAXR = 8, MAXB = 32, NT = 24, WORLD = 160; // 지도 범위: [-80, 80]
				const route = routeIds.map((id) => islands.find((I) => I.id === id)); // 섬과 같은 객체를 가리키게
				const vs = `#version 300 es
				void main(){ vec2 v = vec2((gl_VertexID<<1)&2, gl_VertexID&2); gl_Position = vec4(v*2.-1.,0.,1.); }`;
				const fs = `#version 300 es
				precision highp float; out vec4 o;
				uniform vec2 R; uniform float T; uniform vec2 CAM; uniform float ZOOM; uniform vec2 BOAT; uniform float HEAD; uniform vec2 TGT; uniform float DAY; uniform vec2 MON;
				uniform int NI; uniform vec4 ISL[${MAXI}]; uniform float LIT[${MAXI}]; uniform int NEXT; uniform vec3 ANC; uniform int NR; uniform vec2 ROUTE[${MAXR}]; uniform vec3 MIR; uniform int NB; uniform vec3 BTL[${MAXB}];
				uniform vec2 TRAIL[${NT}]; uniform sampler2D FOG; uniform float WORLD;
				float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
				float noise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f); return mix(mix(hash(i),hash(i+vec2(1,0)),f.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x), f.y); }
				float fbm(vec2 p){ float a=0.5, s=0.; for(int i=0;i<5;i++){ s+=a*noise(p); p=p*2.03+vec2(17.,9.); a*=0.5; } return s; }
				float island(vec2 p, vec4 I){ vec2 d = p - I.xy; float a = atan(d.y, d.x); float r = I.z*(1. + 0.22*sin(3.*a + I.w) + 0.1*sin(7.*a - I.w*2.) + 0.06*sin(13.*a)); return length(d) - r; }
				float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/dot(ba,ba),0.,1.); return length(pa-ba*h); }
				void main(){
					vec2 uv = (gl_FragCoord.xy*2.-R)/R.y;
					vec2 p = CAM + uv*ZOOM*0.5;
					// 가장 가까운 육지
					float d = 1e3; vec4 I = vec4(0.);
					for(int i=0;i<NI;i++){ float di = island(p, ISL[i]); if(di<d){ d=di; I=ISL[i]; } }
					float depth = clamp(d/6., 0., 1.);
					float n1 = fbm(p*0.35 + vec2(T*0.05, T*0.03)), n2 = fbm(p*1.2 - vec2(T*0.08, 0.));
					vec3 deep = mix(vec3(0.02,0.06,0.12), vec3(0.07,0.33,0.48), DAY), shallow = mix(vec3(0.08,0.22,0.3), vec3(0.35,0.75,0.78), DAY);
					vec3 col = mix(shallow, deep, depth);
					col += (n1-0.5)*0.12 + (n2-0.5)*0.06;
					float sp = pow(noise(p*4. + vec2(T*0.6, -T*0.4)), 18.) * (0.5*DAY + 0.15) * (1.-depth*0.5);
					col += sp;
					// 바다 그림자: 지도 가장자리를 도는 무언가
					vec2 mq = p - MON; float mb = length(mq/vec2(4.5, 1.8) ) - 1. + 0.25*fbm(mq*0.8 + T*0.3);
					col *= 1. - 0.5*smoothstep(0.3, -0.4, mb)*step(0., d);
					// 해안 거품
					float foam = smoothstep(0.9, 0.0, abs(d - 0.35 - 0.25*sin(T*1.3 + p.x*0.7 + p.y*0.5))) * smoothstep(0.3,0.7,n2);
					col = mix(col, vec3(0.95), foam*0.8*step(0., d));
					// 육지
					if (d < 0.) {
						vec3 sand = vec3(0.93,0.86,0.68), grass = vec3(0.36,0.62,0.38), dark = vec3(0.22,0.45,0.3);
						float g = fbm(p*0.9 + I.w);
						vec3 land = mix(sand, mix(grass, dark, g), smoothstep(-0.6, -1.6, d));
						vec2 lq = p - I.xy; float tower = length(lq) - 0.42; // 등대
						land = mix(land, vec3(0.97), smoothstep(0.04,-0.04,tower));
						land = mix(land, vec3(0.85,0.2,0.2), smoothstep(0.04,-0.04, abs(length(lq)-0.25)-0.07));
						land *= mix(0.35, 1., DAY);
						col = land;
					}
					// 등대 불빛: 켠 섬은 밝게, 다음 섬은 멀리서도 보이게, 나머지는 희미하게
					for(int i=0;i<NI;i++){ vec2 lq = p - ISL[i].xy; float ang = atan(lq.y, lq.x); float beam = T*0.7 + ISL[i].w; float da = abs(atan(sin(ang-beam), cos(ang-beam))); float L = length(lq); bool nx = i == NEXT; float reach = nx ? 60. : 16.; float b = smoothstep(0.12, 0., da) * smoothstep(reach, 1., L) * step(0.3, L); float k = LIT[i] > 0.5 ? mix(0.4, 0.9, 1.-DAY) : (nx ? mix(0.45, 0.9, 1.-DAY) : mix(0.08, 0.5, 1.-DAY)); col += vec3(1.,0.95,0.7) * b * k; col += vec3(1.,0.85,0.5) * LIT[i] * smoothstep(1.4, 0., L) * 0.7 * (0.8 + 0.2*sin(T*3.)); }
					// 유리병
