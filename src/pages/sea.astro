---
import { getCollection } from 'astro:content';
import { existsSync, readdirSync } from 'node:fs';
import { execSync } from 'node:child_process';
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 섬 = 다녀온 회사. 포트폴리오처럼 회사 워드마크(mark)와 회사명(company)을 쓴다. 사업 수치는 쓰지 않는다. 항로는 시간순이고, 첫 섬에는 두 번 머물렀다.
// 방문자는 첫 섬에서 출항해 시간순으로 항로를 따라간다. 닿을 때마다 등대가 켜지고 지나온 길이 그려지고, 그 섬에서 한 일이 펼쳐진다.
const islands = [
	{ id: 'A', x: -48, y: -46, r: 3.6, seed: 2, title: 'Vi~meal', mark: 'Vi~meal', markColor: '#4fa3e3', company: '와이즈셀렉션(건강비밀)', date: '2018.08 ~ 2021.09 · 2022.02 ~ 2024.10', role: '회사의 첫 번째 개발자로 입사. 런칭부터 MSA 전환까지 하고 한 번 떠났다가, 돌아와서 리뉴얼을 리드했다.',
		stays: [{ date: '18.08 ~ 21.09 (3년 1개월)', role: '회사의 첫 번째 개발자로 입사했다. 초기 모델부터 런칭, MSA 전환, 협업 인프라까지. 3년을 머물고 한 번 떠난다.' }, { date: '22.02 ~ 24.10 (2년 8개월) · 두 번째 정박', role: '다섯 달 만에 돌아왔다. 이번엔 쇼핑몰 리뉴얼을 리드하고 데이터 동기화와 멀티테넌시를 깔았다. 여기서 두 해 반을 더 머물렀다.' }],
		works: [
			{ stay: 1, when: '2018 – 2019', name: '서비스 런칭', desc: '영양제 추천 알고리즘과 성분 시각화(특허 등록), 간편결제·PG 연동과 빌링, 주문→결제 흐름, 쿠폰·마일리지, 주문·배송·제품 백오피스.' },
			{ stay: 1, when: '2019 – 2020', name: 'MSA 전환', desc: '모놀리식을 Eureka·Zuul 기반 마이크로서비스로 분리. Docker Swarm 빌드·배포 자동화와 사용량 기반 오토스케일, ELK 로그 통합과 행동 로그 대시보드.' },
			{ stay: 1, when: '2020 – 2021', name: '외부 협업 인프라', desc: '유통사 회원 대상 추천 API 서버. GitLab CI → ECR → Fargate Blue-Green 무중단 배포. 보험사 PHR 데이터 기반 건강관리·추천 API, SignedJWT 통신 암호화.' },
			{ stay: 2, when: '2022 – 2023', name: '쇼핑몰 리뉴얼 리드', desc: 'DB 설계부터 프로젝트 구조까지. 약사–고객 실시간 채팅 상담(WebSocket, 읽음 표시, 문진·이미지, 알림톡), 영양제 조합 평가·비교, Elasticsearch 검색 고도화.' },
			{ stay: 2, when: '2023', name: '데이터 동기화·운영', desc: '협력사마다 늘어난 DB를 Kafka Connect(CDC)로 실시간 동기화. ELK 클러스터 업그레이드와 Filebeat. Redis 캐싱으로 자가진단 알고리즘 80% 단축.' },
			{ stay: 2, when: '2024', name: '멀티테넌시 솔루션', desc: '여러 협력사에 같은 서비스를 내주기 위한 통합 서비스 설계. SignedJWT·Refresh Token 인증, S3 업로드 공통 모듈.' },
		], stack: ['Java', 'Spring Boot', 'Spring Cloud', 'Docker Swarm', 'MySQL · Aurora', 'Redis', 'Kafka', 'ELK', 'Elasticsearch', 'AWS'], posts: [] },
	{ id: 'B', x: -22, y: -66, r: 2.6, seed: 5, title: 'mubeat', mark: 'mubeat', markColor: '#1a1a1a', company: '블렌딩(Mubeat)', date: '21.09 ~ 22.02 (6개월)', role: '글로벌 팬 플랫폼 백엔드. 생방송 투표가 열리는 순간의 트래픽을 처음 겪었다. 짧게 머물고 첫 섬으로 돌아갔다.',
		works: [
			{ when: '2021 – 2022', name: '아티스트 채널 API', desc: '소식·일정 API. 사용자 제보 → 관리자 검수 → 등록 흐름으로 정확성을 보장.' },
			{ when: '', name: 'Redis 캐시', desc: '좋아요·회원 맞춤 데이터에 캐시를 넣어 투표 피크의 서버 부하와 불필요한 호출을 줄였다.' },
			{ when: '', name: '클라우드 비용 배치', desc: 'AWS 약정(Savings Plans) 만료를 주기 점검해 한 달 전에 Slack으로 알리는 배치.' },
		], stack: ['Java', 'Spring', 'Python', 'Redis', 'MySQL', 'AWS'], posts: [] },
	{ id: 'C', x: -58, y: -4, r: 2.4, seed: 8, title: 'NAAFAA', mark: 'NAAFAA', markColor: '#2a9d8f', company: '로봇앤컴(NAAFAA)', date: '24.12 ~ 25.02 (3개월)', role: '병원 SaaS와 환자 앱을 위한 통합 인증을 설계했다. 석 달 머문 작은 섬.',
		works: [
			{ when: '2024 – 2025', name: 'Keycloak 통합 인증', desc: '병원별 독립 인증 클라이언트를 가진 멀티테넌시 구조. Realm · Clients · Groups · Roles 설계.' },
			{ when: '', name: '관리 API', desc: 'Keycloak Admin API를 감싼 API. 병원 관리자가 대시보드 없이 사용자 등록·그룹·권한을 직접 관리.' },
		], stack: ['Kotlin', 'Spring Boot', 'WebFlux', 'Spring Security', 'PostgreSQL', 'Keycloak'], posts: [] },
	{ id: 'D', x: -22, y: 24, r: 3.9, seed: 7, title: 'LEZHIN', mark: 'LEZHIN', markColor: '#d9262e', company: '레진엔터테인먼트 (키다리스튜디오)', date: '2025.04 ~ 재직 중', role: '독자가 읽고·사고·발견하는 경로를 고치고, 그 위에 게이미피케이션 서버와 실시간 이벤트 서버를 새로 지었다. 아직 여기 묶여 있는 배.',
		works: [
			{ when: '2026', name: '실시간 이벤트 서버', desc: '라이브 채팅과 서바이벌 퀴즈용 WebSocket 서버를 혼자 설계부터 오픈·운영까지. 렌더 그룹 채널 분리로 팬아웃 초당 145만 → 5만 프레임. Lua 원자 연산 선착순 입장으로 정원 초과 0건, 멱등 보상으로 오지급 0건. 부하 테스트 봇 제작.' },
			{ when: '2025 –', name: '게이미피케이션 서버', desc: '아키텍처 선정부터 구축(WebFlux · R2DBC · Redis · Kafka). 행동 로그 → Kafka → 판정 → 보상 파이프라인으로 출석·미션·룰렛·투표를 확장. 설정 기반 룰렛으로 코드 수정 없이 재개최, 두 리전 동시 운영.' },
			{ when: '2026', name: '뷰어 API 성능', desc: '가장 많이 불리는 레거시 단일 API를 분리 이관. COLD 5.48s → 0.50s, 응답 4.5MB → 2.5KB. 열람 이력을 SQS로 넘겨 /me 1.35s → 0.57s.' },
			{ when: '2025', name: '추천 파이프라인', desc: 'LightFM 하이브리드 추천. 수집(Airflow) · 학습(EC2) · 서빙(K8s) 3계층, 무중단 모델 교체, 캐시 → 모델 → 폴백.' },
			{ when: '', name: '그 외', desc: '내서재 리뉴얼, 사전구매 구매 로직, 배치 Airflow 이관, 데이터 카탈로그 구축, 재화 지급 API, 저장소 규칙을 AI가 읽는 형태로 코드화해 팀 공용 스킬로 배포.' },
		], stack: ['Kotlin', 'WebFlux', 'R2DBC', 'Redis', 'Kafka', 'SQS', 'Kubernetes', 'Airflow', 'Python', 'FastAPI'],
		posts: ['2026-09-05-fanout-group-channels', '2026-09-10-load-test-bots', '2026-09-22-view-history-sqs', '2026-09-12-kube-schedule-scaler-annotation', '2026-09-04-parallel-subagent-codebase-review', '2026-09-09-gitlab-mr-skill'] },
	// 조선소: 항로에 없는 섬. 이 배와 바다를 지은 곳. 회사가 아니라 이 블로그의 제작 기록이다.
	{ id: 'S', x: -6, y: 36, r: 3.2, seed: 11, title: '조선소', date: '2026.10.12 –', role: '이 배와 바다를 지은 곳. 혼자 지은 건 아니다. Claude Code가 설계와 코드를, Codex가 그림을 맡았다. 나는 방향을 정하고, 마음에 안 들면 다시 시켰다.',
		labels: { works: '건조 기록', stack: '자재', posts: '건조 일지' },
		works: [
			{ when: '2026.10.12', name: '블로그 건조', desc: 'Astro로 뼈대를 세우고 GitHub Pages에 올리는 데 한 세션. 첫 배포를 보고 말투와 디자인을 전부 뒤집었다. 미니멀 텍스트, 반말 일기체.' },
			{ when: '10.13', name: '홈 장치 시제품', desc: '여섯 가지 안을 거쳤다. 1인칭 세계, 입자 4만 개, 구슬 굴리기, 카드팩, 그리고 이 바다. 카드팩과 바다가 남았다.' },
			{ when: '10.13 – 14', name: '바다', desc: 'WebGL2 셰이더 하나로 물결·안개·등대 불빛·항로를 그린다. 섬·배·유리병은 Codex가 그린 투명 스프라이트를 캔버스로 얹었다. 회사는 섬, 가치관은 편지, 이력은 항로가 됐다.' },
			{ when: '10.14', name: '글', desc: '지난 작업 세션 기록에서 글감을 추려 썼다. 그림은 글 안에 적어둔 프롬프트로 Codex가 만들고, 스크립트가 그 자리에 끼운다.' },
			{ when: '', name: '규칙', desc: '저장소 규칙 파일에 말투·익명화·이미지 파이프라인을 적어뒀다. AI가 읽는 문서라 사람이 읽어도 짧다.' },
		], stack: ['Astro', 'WebGL2', 'Claude Code', 'Codex CLI', 'GitHub Actions', 'Nanum Pen Script'], posts: ['2026-10-12-blog-built-with-claude-code'] },
];
// 조선소 통계: 커밋 수, 그림 수, 건조 일수
const BUILT_FROM = '2026-10-12';
let commits = 0; try { commits = Number(execSync('git rev-list --count HEAD', { encoding: 'utf8' }).trim()); } catch {}
const imageCount = ['public/images', 'public/sea'].reduce((n, d) => n + (existsSync(d) ? readdirSync(d).length : 0), 0);
const route = ['A', 'B', 'A', 'C', 'D'].map((id) => islands.find((I) => I.id === id)!);
const yard = islands.find((I) => I.id === 'S')!;
const cur = route[route.length - 1];
const SAIL_FROM = '2018-08-01';
// 유리병 편지 = 그 시절 항로 위에서 쓴 편지. leg = 구간 번호, t = 구간 위 위치, s = 항로에서 옆으로 벗어난 거리.
const values = [
	{ id: 'b2', leg: 0, t: 0.32, s: -2.5, when: '2019년 어느 밤, 첫 섬에서', text: '혼자 서비스를 띄우던 때. 기능을 하나 붙일 때마다 결제·주문·백오피스가 같이 흔들렸다. 그때 알았다. 기능 하나보다 그 밑에 깔린 계층이 중요하다는 걸. 도메인이 늘어도 다시 만들지 않는 층을 먼저 짓는다. 지금도 그렇게 한다.' },
	{ id: 'b4', leg: 0, t: 0.68, s: 2.5, when: '2020년 새벽, 첫 섬을 떠나기 전', text: '서버가 죽었다. 처음엔 감으로 재배포만 반복했다. 로그를 한곳에 모으고 똑같은 상황을 다시 만들어보니 원인은 전혀 다른 데 있었다. 그날 이후 장애는 추측하지 않는다. 재현 실험으로 원인을 특정한다.' },
	{ id: 'b5', leg: 1, t: 0.5, s: -2.5, when: '2022년 겨울, 두 번째 섬을 떠나며', text: '생방송 투표가 열리는 순간 요청이 한꺼번에 몰렸다. 캐시 없이는 버틸 수 없다는 걸 몸으로 배운 짧은 섬. 요청이 한순간에 몰려도 정원·보상·판정이 어긋나면 안 된다. 원자 연산과 멱등이 기본이 된 건 여기서부터다.' },
	{ id: 'b3', leg: 2, t: 0.48, s: 2.5, when: '2024년 가을, 첫 섬을 두 번째로 떠나며', text: '여섯 해를 머문 섬을 떠난다. 캐시로 80% 빨라졌다고 적었지만 그 숫자는 재기 전까지 믿지 않았다. 모든 변경은 산식으로 먼저 계산하고 실측으로 확인한 뒤에 반영한다. 추측으로 올린 배포는 한 번도 좋게 끝난 적이 없다.' },
	{ id: 'b6', leg: 3, t: 0.34, s: -2.5, when: '2025년 봄, 네 번째 섬으로 가는 길', text: 'AI를 서비스에도 쓰고 일하는 방식에도 쓰기 시작했다. 추천은 캐시 → 모델 → 폴백으로 언제나 답이 나오게. 저장소 규칙은 AI가 읽을 수 있는 형태로 적는다. 이 바다도 그렇게 만들었다. 다만 AI가 낸 코드는 계산하고 실측한 뒤에만 반영한다.' },
	{ id: 'b1', leg: 3, t: 0.68, s: 2.5, when: '2026년, 지금 섬 앞바다에서', text: '여덟 해째 백엔드. Kotlin·Java(Spring, WebFlux)와 Python 사이를 오간다. 트래픽이 몰리는 순간에도 흔들리지 않는 서버를 만드는 일이 여전히 제일 재밌다. 배는 아직 항해 중이다.' },
].map((b) => { const a = route[b.leg], c = route[b.leg + 1], dx = c.x - a.x, dy = c.y - a.y, L = Math.hypot(dx, dy); return { id: b.id, kind: 1, when: b.when, text: b.text, x: a.x + dx * b.t - (dy / L) * b.s, y: a.y + dy * b.t + (dx / L) * b.s }; });
// 일지 유리병 = 블로그 글. 지금 섬 앞바다에 떠 있다. 새 글이 올라오면 하나 더. 위치는 글 id 해시.
const hash = (t: string) => { let h = 2166136261; for (const c of t) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; } return h; };
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const logs = posts.map((p) => {
	const h = hash(p.id), a = (h % 360) * Math.PI / 180, r = cur.r * 1.25 + 5.5 + ((h >>> 9) % 6);
	return { id: `log-${p.id}`, x: cur.x + Math.cos(a) * r, y: cur.y + Math.sin(a) * r, kind: 2, title: p.data.title, date: p.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.'), href: `/blog/${p.id}/` };
});
const bottles = [...values, ...logs];
const postTitle = Object.fromEntries(posts.map((p) => [p.id, p.data.title]));
const islandsOut = islands.map((I) => ({ ...I, posts: I.posts.filter((s) => postTitle[s]).map((s) => ({ title: postTitle[s], href: `/blog/${s}/` })), note: I === yard ? `커밋 ${commits}개 · 그림 ${imageCount}장 · 글 ${posts.length}편 · 건조 ${Math.max(1, Math.floor((Date.now() - new Date(BUILT_FROM).valueOf()) / 864e5))}일째` : '' }));
const hasCv = existsSync('public/cv.pdf');
// 선실에 걸어둘 것. 책은 비워두면 안 보인다.
const captain = { reading: '', now: ['이 바다와 카드팩을 Claude Code와 같이 만드는 중', 'Kotlin · WebFlux · Redis · Kafka 위에서 실시간 서버를 굴리는 중'] };
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`항해 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&display=swap" rel="stylesheet" />
		<style is:global>
			html, body { height: 100%; overflow: hidden; background: #0b2a36; }
			#gl, #fx { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
			#gl { touch-action: none; cursor: crosshair; }
			#fx { pointer-events: none; }
			.hud { position: fixed; inset: 0; pointer-events: none; color: #fff; text-shadow: 0 1px 2px rgba(0,20,30,0.6), 0 0 14px rgba(0,20,30,0.5); }
			.hud .top { position: absolute; top: calc(1.2rem + env(safe-area-inset-top, 0px)); left: 1.25rem; right: 1.25rem; display: flex; justify-content: space-between; align-items: baseline; } .hud .top a { pointer-events: auto; }
			.hud .brand { font-weight: 700; text-decoration: none; font-size: 1.05rem; color: inherit; }
			.hud .links { display: flex; gap: 1.2em; font-size: 0.95rem; } .hud .links a { text-decoration: none; color: inherit; opacity: 0.85; }
			.intro { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; transition: opacity 0.5s; padding: 0 1.25rem; }
			.intro h1 { font-size: clamp(2.4rem, 7vw, 4rem); letter-spacing: -0.03em; margin: 0 0 0.2em; font-weight: 800; }
			.intro p { margin: 0; opacity: 0.9; line-height: 1.6; }
			.intro .go { margin-top: 2em; font-family: var(--mono); font-size: 0.85rem; opacity: 0.9; animation: pulse 1.6s ease-in-out infinite; }
			@keyframes pulse { 50% { opacity: 0.3; } }
			.intro.off { opacity: 0; }
			.mirage, .next { position: absolute; left: 0; top: 0; font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.15em; opacity: 0; transition: opacity 0.6s; translate: -50% -50%; white-space: nowrap; }
			.mirage.on { opacity: 0.55; animation: pulse 3s ease-in-out infinite; }
			.next.on { opacity: 0.8; }
			.next i { display: inline-block; font-style: normal; margin-right: 0.4em; }
			.toast { position: absolute; left: 50%; top: 18%; transform: translateX(-50%); width: min(90vw, 460px); background: rgba(0,20,30,0.55); backdrop-filter: blur(6px); border-radius: 12px; padding: 0.9em 1.1em; font-size: 0.95rem; line-height: 1.6; text-shadow: none; opacity: 0; transition: opacity 0.4s, translate 0.4s; translate: 0 8px; }
			.toast.on { opacity: 1; translate: 0 0; }
			.toast .k { display: block; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.2em; opacity: 0.8; margin-bottom: 0.4em; }
			/* 겹창: 선실·섬·편지 */
			.modal { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(2,10,14,0.55); backdrop-filter: blur(3px); opacity: 0; pointer-events: none; transition: opacity 0.35s; text-shadow: none; padding: 1rem; }
			.modal.on { opacity: 1; pointer-events: auto; }
			.modal > div { position: relative; width: min(92vw, 560px); max-height: 88vh; overflow: auto; border-radius: 14px; box-shadow: 0 30px 80px rgba(0,0,0,0.6); transform: scale(0.96); transition: transform 0.35s; }
			.modal.on > div { transform: none; }
			.modal .x { position: absolute; right: 0.8rem; top: 0.6rem; background: none; border: 0; color: inherit; font-size: 1.5rem; cursor: pointer; opacity: 0.7; }
			.modal .k { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.2em; opacity: 0.7; margin: 1.3em 0 0.4em; }
			.modal h2 { margin: 0; font-size: 1.35rem; letter-spacing: -0.02em; }
			.modal p { margin: 0; line-height: 1.65; font-size: 0.95rem; }
			.modal ul { margin: 0; padding-left: 1.1em; line-height: 1.7; font-size: 0.95rem; }
			/* 선실: 나무 */
			.cabin .room { background: linear-gradient(160deg, #3a2a1e, #1f1611); border: 1px solid rgba(255,220,160,0.25); padding: 1.4rem 1.5rem; color: #f3e9d6; }
			.cabin .room.bg { background: linear-gradient(rgba(20,12,6,0.82), rgba(20,12,6,0.9)), var(--cabin) center / cover; }
			.cabin a { color: #fde68a; }
			.cabin .row { display: flex; gap: 0.6em; flex-wrap: wrap; margin-top: 0.4em; }
			.cabin .row a { font-family: var(--mono); font-size: 0.82rem; padding: 0.35em 0.9em; border: 1px solid rgba(255,220,160,0.4); border-radius: 999px; text-decoration: none; color: inherit; }
			/* 섬: 항해일지 종이 */
			.paper { background: #f1e6cf; color: #2a2118; padding: 1.4rem 1.6rem 1.6rem; }
			.paper.bg { background: var(--paper) center / cover, #f1e6cf; }
			.isle img { display: block; width: min(60%, 260px); margin: 0 auto 0.6rem; filter: drop-shadow(0 10px 20px rgba(0,0,0,0.25)); }
			.isle h2.mark { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
			.isle .d { font-size: 0.92rem; opacity: 0.85; margin-top: 0.45em; } .isle .d b { font-weight: 700; opacity: 1; } .isle .d b:not(:empty)::after { content: ' | '; font-weight: 400; opacity: 0.5; } .isle .d span { opacity: 0.75; }
			.isle .role { margin-top: 0.8em; font-size: 0.98rem; }
			.isle .works { list-style: none; padding: 0; }
			.isle .works li { padding: 0.55em 0; border-top: 1px dashed rgba(42,33,24,0.25); }
			.isle .works b { display: block; font-size: 0.95rem; }
			.isle .works small { font-family: var(--mono); font-size: 0.72rem; opacity: 0.6; letter-spacing: 0.05em; }
			.isle .works span { display: block; font-size: 0.9rem; line-height: 1.6; opacity: 0.9; }
			.isle .chips { display: flex; flex-wrap: wrap; gap: 0.4em; }
			.isle .chips span { font-family: var(--mono); font-size: 0.75rem; padding: 0.25em 0.7em; border: 1px solid rgba(42,33,24,0.35); border-radius: 999px; }
			.isle a { color: #7a3b14; }
			.isle .go { display: block; margin: 1.6em auto 0; background: #2a2118; color: #f1e6cf; border: 0; border-radius: 999px; padding: 0.7em 1.6em; font-family: var(--mono); font-size: 0.85rem; cursor: pointer; }
			/* 편지 */
			.letter .paper { font-family: 'Nanum Pen Script', var(--font); font-size: 1.55rem; line-height: 1.45; padding: 1.8rem 1.9rem 1.6rem; max-width: 460px; }
			.letter .when { font-size: 1.1rem; opacity: 0.65; margin-bottom: 0.6em; }
			.letter p { font-size: inherit; line-height: inherit; }
			.letter .sig { text-align: right; margin-top: 0.8em; opacity: 0.8; }
			.letter a { display: inline-block; margin-top: 0.6em; color: #7a3b14; font-size: 1.2rem; } .letter a[hidden] { display: none; }
			.letter .fold { display: block; margin: 1.2em auto 0; background: none; border: 1px solid rgba(42,33,24,0.4); color: #2a2118; border-radius: 999px; padding: 0.35em 1.1em; font-family: var(--mono); font-size: 0.78rem; cursor: pointer; }
			.say { position: absolute; left: 1.25rem; bottom: calc(3.4rem + env(safe-area-inset-bottom, 0px)); display: flex; align-items: flex-end; gap: 0.6rem; max-width: min(80vw, 420px); opacity: 0; translate: 0 8px; transition: opacity 0.35s, translate 0.35s; }
			.say.on { opacity: 1; translate: 0 0; }
			.say img { width: 84px; height: 84px; object-fit: contain; filter: drop-shadow(0 6px 10px rgba(0,0,0,0.4)); }
			.say .bubble { background: rgba(0,20,30,0.6); backdrop-filter: blur(6px); border-radius: 12px 12px 12px 4px; padding: 0.6em 0.9em; font-size: 0.95rem; line-height: 1.5; text-shadow: none; margin-bottom: 14px; }
			.say .bubble .who { display: block; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.2em; opacity: 0.7; margin-bottom: 0.2em; }
			.cabin .face { float: right; width: 96px; height: 96px; object-fit: contain; margin: -0.3rem 0.6rem 0.4rem 1rem; filter: drop-shadow(0 6px 10px rgba(0,0,0,0.5)); }
			.cabin .x { z-index: 1; }
			.isle .note { font-family: var(--mono); font-size: 0.78rem; opacity: 0.7; margin-top: 0.6em; }
			.help { position: absolute; left: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.85; }
			.stat { position: absolute; right: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.85; text-align: right; }
			/* 지도 */
			.map { position: absolute; right: 1.25rem; top: calc(4.2rem + env(safe-area-inset-top, 0px)); width: 150px; height: 150px; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.35); box-shadow: 0 10px 30px rgba(0,0,0,0.4); pointer-events: auto; cursor: pointer; transition: width 0.3s, height 0.3s; background: #061a22; }
			.map canvas { width: 100%; height: 100%; display: block; }
			.map .z { position: absolute; left: 6px; bottom: 4px; font-family: var(--mono); font-size: 0.68rem; opacity: 0.8; }
			.map.big { width: min(92vw, 560px); height: min(92vw, 560px); right: 50%; top: 50%; translate: 50% -50%; }
			@media (max-width: 700px) { .map { width: 110px; height: 110px; } .help { bottom: calc(2.9rem + env(safe-area-inset-bottom, 0px)); } .say { bottom: calc(5.2rem + env(safe-area-inset-bottom, 0px)); } .say img { width: 64px; height: 64px; } .letter .paper { font-size: 1.35rem; } .cabin .face { width: 72px; height: 72px; } }
			.fallback { max-width: 660px; margin: 4rem auto; padding: 0 1.25rem; display: none; color: #e5e7eb; }
		</style>
	</head>
	<body>
		<canvas id="gl"></canvas>
		<canvas id="fx"></canvas>
		<div class="hud" id="hud">
			<div class="top"><a class="brand" href="/">{SITE_TITLE}</a><div class="links"><a href="/blog">글</a><a href="/about">소개</a></div></div>
			<div class="intro" id="intro"><div><h1>easyho.log</h1><p>2018년 8월, 첫 섬 앞바다. 여기서 출항한다.<br />등대 불빛을 따라가면 다음 섬이 나온다.</p><div class="go">바다를 눌러 출항</div></div></div>
			<div class="mirage" id="mirage">다음 섬 ?</div>
			<div class="next" id="next"><i>➤</i>다음 섬</div>
			<div class="toast" id="toast"><span class="k" id="tk"></span><span id="tt"></span></div>
			<div class="map" id="map"><canvas id="mc"></canvas><div class="z" id="mz">M · 크게</div></div>
			<div class="say" id="say"><img src="/sea/captain.webp" alt="" /><div class="bubble"><span class="who">CAPTAIN</span><span id="sayt"></span></div></div>
			<div class="help">클릭 · 터치로 항해 · 배를 두 번 누르면 선실</div>
			<div class="stat" id="stat"></div>
			<div class="modal isle" id="isle"><div class="paper" id="ipaper">
				<button class="x" id="ix" aria-label="닫기">×</button>
				<img id="ii" alt="" />
				<div class="k">ISLAND <span id="in"></span> · 항해일지</div>
				<h2 id="it"></h2><div class="d"><b id="ico"></b><span id="idate"></span></div>
				<p class="role" id="ir"></p>
				<div class="note" id="inote"></div>
				<div class="k" id="iwk">여기서 한 일</div>
				<ul class="works" id="iw"></ul>
				<div class="k" id="isk">STACK</div>
				<div class="chips" id="is"></div>
				<div id="ipw"><div class="k" id="ipk">여기서 쓴 글</div><ul id="ipl"></ul></div>
				<button class="go" id="ig">닻 올리기 →</button>
			</div></div>
			<div class="modal letter" id="letter"><div class="paper" id="lpaper">
				<div class="when" id="lw"></div>
				<p id="lt"></p>
				<div class="sig">— 선장</div>
				<a id="la" href="#" hidden>일지 읽기 →</a>
				<button class="fold" id="lx">접어서 챙기기</button>
			</div></div>
			<div class="modal cabin" id="cabin"><div class="room" id="croom">
				<button class="x" id="cx" aria-label="닫기">×</button>
				<img class="face" src="/sea/captain.webp" alt="" />
				<h2>선실</h2>
				<div class="k">CAPTAIN</div>
				<p>8년 차 백엔드. 웹툰 플랫폼에서 뷰어·추천·게이미피케이션·실시간 서버를 만든다. 스타트업의 첫 번째 개발자로 시작해 런칭, MSA 전환, 리뉴얼까지 한 바퀴 돌아봤다. 요청이 한순간에 몰려도 정원·보상·판정이 어긋나지 않게 하는 일을 좋아한다.</p>
				<div class="row"><a href="mailto:dev.easyho@gmail.com">dev.easyho@gmail.com</a>{hasCv && <a href="/cv.pdf">이력서 PDF</a>}</div>
				<div class="k">건진 편지</div>
				<ul id="vals"></ul>
				<div class="k">NOW</div>
				<ul>{captain.now.map((n) => <li>{n}</li>)}{captain.reading && <li>읽는 책 · {captain.reading}</li>}</ul>
				<div class="k">주운 일지</div>
				<ul id="logs"></ul>
				<div class="k">LOG</div>
				<p id="clog"></p>
			</div></div>
		</div>
		<div class="fallback" id="fallback"><ul class="post-list">{islands.map((m) => <li><span>{m.date}</span>{m.title}</li>)}</ul></div>
		<script define:vars={{ islands: islandsOut, routeIds: route.map((I) => I.id), bottles, SAIL_FROM }}>
			const canvas = document.getElementById('gl');
			const gl = canvas.getContext('webgl2', { antialias: false, alpha: false });
			if (!gl) { document.getElementById('fallback').style.display = 'block'; document.getElementById('hud').style.display = 'none'; canvas.remove(); document.getElementById('fx').remove(); document.body.style.overflow = 'auto'; }
			else {
				const MAXI = 8, MAXR = 8, MAXB = 32, NT = 24, WORLD = 160; // 지도 범위: [-80, 80]
				const route = routeIds.map((id) => islands.find((I) => I.id === id)); // 섬과 같은 객체를 가리키게
				const vs = `#version 300 es
				void main(){ vec2 v = vec2((gl_VertexID<<1)&2, gl_VertexID&2); gl_Position = vec4(v*2.-1.,0.,1.); }`;
				const fs = `#version 300 es
				precision highp float; out vec4 o;
				uniform vec2 R; uniform float T; uniform vec2 CAM; uniform float ZOOM; uniform vec2 BOAT; uniform vec2 TGT; uniform float DAY; uniform vec2 MON;
				uniform int NI; uniform vec4 ISL[${MAXI}]; uniform float LIT[${MAXI}]; uniform int NEXT; uniform vec3 ANC; uniform int NR; uniform vec2 ROUTE[${MAXR}]; uniform vec3 MIR; uniform int NB; uniform vec3 BTL[${MAXB}];
				uniform vec2 TRAIL[${NT}]; uniform sampler2D FOG; uniform float WORLD;
				float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
				float noise(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.-2.*f); return mix(mix(hash(i),hash(i+vec2(1,0)),f.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x), f.y); }
				float fbm(vec2 p){ float a=0.5, s=0.; for(int i=0;i<5;i++){ s+=a*noise(p); p=p*2.03+vec2(17.,9.); a*=0.5; } return s; }
				float island(vec2 p, vec4 I){ vec2 d = p - I.xy; float a = atan(d.y, d.x); float r = I.z*(1. + 0.06*sin(5.*a + I.w)); return length(d) - r; }
				float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/dot(ba,ba),0.,1.); return length(pa-ba*h); }
				void main(){
					vec2 uv = (gl_FragCoord.xy*2.-R)/R.y;
					vec2 p = CAM + uv*ZOOM*0.5;
					// 가장 가까운 육지
					float d = 1e3; vec4 I = vec4(0.);
					for(int i=0;i<NI;i++){ float di = island(p, ISL[i]); if(di<d){ d=di; I=ISL[i]; } }
					float depth = clamp(d/6., 0., 1.);
					float n1 = fbm(p*0.35 + vec2(T*0.05, T*0.03)), n2 = fbm(p*1.2 - vec2(T*0.08, 0.));
					vec3 deep = mix(vec3(0.02,0.06,0.12), vec3(0.07,0.33,0.48), DAY), shallow = mix(vec3(0.08,0.22,0.3), vec3(0.35,0.75,0.78), DAY);
					vec3 col = mix(shallow, deep, depth);
					col += (n1-0.5)*0.12 + (n2-0.5)*0.06;
					float sp = pow(noise(p*4. + vec2(T*0.6, -T*0.4)), 18.) * (0.5*DAY + 0.15) * (1.-depth*0.5);
					col += sp;
					// 바다 그림자: 지도 가장자리를 도는 무언가
					vec2 mq = p - MON; float mb = length(mq/vec2(4.5, 1.8) ) - 1. + 0.25*fbm(mq*0.8 + T*0.3);
					col *= 1. - 0.5*smoothstep(0.3, -0.4, mb)*step(0., d);
					// 해안 거품
					float foam = smoothstep(0.9, 0.0, abs(d - 0.35 - 0.25*sin(T*1.3 + p.x*0.7 + p.y*0.5))) * smoothstep(0.3,0.7,n2);
					col = mix(col, vec3(0.95), foam*0.8*step(0., d));
					// 육지 자리는 모래색. 섬 그림은 위 레이어가 그린다
					if (d < 0.) col = vec3(0.93,0.86,0.68) * mix(0.35, 1., DAY);
					// 등대 불빛: 켠 섬은 밝게, 다음 섬은 멀리서도 보이게, 나머지는 희미하게
					for(int i=0;i<NI;i++){ vec2 lq = p - ISL[i].xy; float ang = atan(lq.y, lq.x); float beam = T*0.7 + ISL[i].w; float da = abs(atan(sin(ang-beam), cos(ang-beam))); float L = length(lq); bool nx = i == NEXT; float reach = nx ? 60. : 16.; float b = smoothstep(0.12, 0., da) * smoothstep(reach, 1., L) * step(ISL[i].z*0.9, L); float k = LIT[i] > 0.5 ? mix(0.4, 0.9, 1.-DAY) : (nx ? mix(0.45, 0.9, 1.-DAY) : mix(0.08, 0.5, 1.-DAY)); col += vec3(1.,0.95,0.7) * b * k; }
					// 유리병 자리의 물결 링. 병 그림은 위 레이어가 그린다
					for(int i=0;i<NB;i++){ if (BTL[i].z < 0.5) continue; vec2 bq = p - BTL[i].xy - vec2(0.5*sin(T*0.6+float(i)), 0.4*cos(T*0.5+float(i)*1.7)); float ring = abs(length(bq) - 1.2 - 0.3*sin(T*2.+float(i))); col += vec3(1.) * smoothstep(0.1,0.,ring)*0.25; }
					// 닻: 상륙 순간 퍼지는 링
					float at = T - ANC.z; if (at > 0. && at < 1.6) { float ar = abs(length(p - ANC.xy) - at * 4.); col += vec3(1.) * smoothstep(0.25, 0., ar) * (1. - at / 1.6) * 0.6; }
					// 다음 섬(신기루): 항해를 마친 뒤에만 안개 너머에 보인다
					float md = island(p, vec4(MIR.xy, 3.2, 4.)); col = mix(col, mix(col, vec3(0.5,0.6,0.6), 0.5), smoothstep(0.1,-0.1,md));
					// 지나온 항로: 굵은 점선. 닿은 섬까지는 또렷하게, 다음 섬까지는 희미한 안내선으로
					for(int i=0;i<NR;i++){ if (i == NR-1 && NEXT < 0) break; float s = sdSeg(p, ROUTE[i], ROUTE[i+1]); float along = dot(p-ROUTE[i], normalize(ROUTE[i+1]-ROUTE[i])); float dash = step(0.45, fract(along/2.6)); float a = (i < NR-1) ? 0.85 : 0.28; col = mix(col, vec3(0.02,0.08,0.12), smoothstep(0.42,0.28,s)*dash*0.45*a*step(0., d)); col = mix(col, vec3(1.,0.97,0.85), smoothstep(0.26,0.14,s)*dash*a*step(0., d)); }
					// 항적
					for(int i=0;i<${NT}-1;i++){ float s = sdSeg(p, TRAIL[i], TRAIL[i+1]); float w = 0.15 + 0.5*float(i)/float(${NT}); col = mix(col, vec3(0.95), smoothstep(w, w-0.12, s) * (1.-float(i)/float(${NT})) * 0.5 * smoothstep(0.4,0.6,n2)); }
					// 목적지 링
					float tr = abs(length(p-TGT) - 0.9 - 0.15*sin(T*4.)); col = mix(col, vec3(1.), smoothstep(0.12,0.0,tr)*0.7);
					// 배 그림자
					float bs = length((p - BOAT - vec2(0.15,-0.2))/vec2(1.7,1.1)) - 1.; col *= 1. - 0.25*smoothstep(0.2,-0.2,bs);
					// 안개
					float fog = texture(FOG, (p + WORLD*0.5)/WORLD).r;
					vec3 fogCol = mix(vec3(0.05,0.07,0.1), vec3(0.80,0.86,0.9), DAY);
					col = mix(mix(fogCol, col, 0.3), col, fog);
					col *= 1. - 0.25*dot(uv*0.5, uv*0.5);
					o = vec4(col, 1.);
				}`;
				const prog = gl.createProgram();
				for (const [type, src] of [[gl.VERTEX_SHADER, vs], [gl.FRAGMENT_SHADER, fs]]) { const sh = gl.createShader(type); gl.shaderSource(sh, src); gl.compileShader(sh); if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(sh)); gl.attachShader(prog, sh); }
				gl.linkProgram(prog); gl.useProgram(prog);
				const U = (n) => gl.getUniformLocation(prog, n);
				const islArr = new Float32Array(MAXI * 4); islands.forEach((I, i) => islArr.set([I.x, I.y, I.r, I.seed], i * 4));
				gl.uniform4fv(U('ISL'), islArr); gl.uniform1i(U('NI'), islands.length); gl.uniform1f(U('WORLD'), WORLD);
				const rtArr = new Float32Array(MAXR * 2); route.forEach((P, i) => rtArr.set([P.x, P.y], i * 2));
