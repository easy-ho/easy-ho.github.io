					const x = (e.clientX - r.left) / r.width * WORLD - WORLD / 2, y = WORLD / 2 - (e.clientY - r.top) / r.height * WORLD;
					goTo(Math.max(-74, Math.min(74, x)), Math.max(-74, Math.min(74, y)));
					if (map.classList.contains('big')) { map.classList.remove('big'); mz.textContent = 'M · 크게'; }
				});
				addEventListener('keydown', (e) => { if (e.key === 'm' || e.key === 'M') { map.classList.toggle('big'); mz.textContent = map.classList.contains('big') ? '' : 'M · 크게'; } if (e.key === 'Escape') { map.classList.remove('big'); mz.textContent = 'M · 크게'; closeCabin(); closeLetter(); if (isle.classList.contains('on')) closeIsle(); } });
				// 위 레이어: 섬·유리병·배 그림. 안개 속은 흐리게, 밤엔 어둡게
				function drawArt(t) {
					const c = fctx2, P = PPU() * DPR; c.setTransform(1, 0, 0, 1, 0, 0); c.clearRect(0, 0, fx.width, fx.height);
					c.filter = day < 0.999 ? `brightness(${(0.45 + 0.55 * day).toFixed(2)})` : 'none';
					const at = (x, y) => [(innerWidth / 2 + (x - cam.x) * PPU()) * DPR, (innerHeight / 2 - (y - cam.y) * PPU()) * DPR];
					for (const I of lands) { const im = art.isle[I.id]; if (!ok(im)) continue; const [sx, sy] = at(I.x, I.y), w = I.r * 2.9 * P; if (sx < -w || sx > fx.width + w || sy < -w || sy > fx.height + w) continue; c.globalAlpha = Math.max(0.12, fogAt(I.x, I.y)); c.drawImage(im, sx - w / 2, sy - w / 2, w, w); }
					if (mirage && ok(art.isle.A)) { const [sx, sy] = at(mirage.x, mirage.y), w = 3.2 * 2.9 * P; c.globalAlpha = 0.25 + 0.08 * Math.sin(t * 1.5); c.drawImage(art.isle.A, sx - w / 2, sy - w / 2, w, w); }
					bottles.forEach((B, i) => { if (got.has(B.id)) return; const im = B.kind === 2 ? (ok(art.log) ? art.log : art.bottle) : art.bottle; if (!ok(im)) return; const bx = B.x + 0.5 * Math.sin(t * 0.6 + i), by = B.y + 0.4 * Math.cos(t * 0.5 + i * 1.7); const [sx, sy] = at(bx, by), w = 1.9 * P; if (sx < -w || sx > fx.width + w || sy < -w || sy > fx.height + w) return; c.globalAlpha = Math.max(0.1, fogAt(B.x, B.y)); c.save(); c.translate(sx, sy); c.rotate(0.35 * Math.sin(t * 0.8 + i)); c.drawImage(im, -w / 2, -w / 2, w, w); c.restore(); });
					if (ok(art.boat)) { const [sx, sy] = at(boat.x, boat.y), w = 4.2 * P; c.globalAlpha = 1; c.save(); c.translate(sx, sy); c.rotate(-boat.h + 0.03 * Math.sin(t * 2.2)); c.drawImage(art.boat, -w / 2, -w / 2, w, w); c.restore(); }
					c.globalAlpha = 1; c.filter = 'none';
				}
				let last = performance.now(), t0 = last, trailT = 0, mapT = 0, landT = 0;
				function step(dt, now) {
					if (sailing && !anyOpen()) {
						const dx = tgt.x - boat.x, dy = tgt.y - boat.y, dist = Math.hypot(dx, dy);
						const want = Math.atan2(dy, dx); let da = want - boat.h; da = Math.atan2(Math.sin(da), Math.cos(da));
						boat.h += Math.max(-2.4 * dt, Math.min(2.4 * dt, da));
						const target = dist < 1.2 ? 0 : Math.min(12, dist * 1.4) * (1 - Math.min(1, Math.abs(da) / 1.2) * 0.8);
						boat.v += (target - boat.v) * Math.min(1, dt * 2.5);
						if (dist < 1.2 && boat.v < 0.3) sailing = false;
					} else boat.v *= 0.96;
					let nx = boat.x + Math.cos(boat.h) * boat.v * dt, ny = boat.y + Math.sin(boat.h) * boat.v * dt;
					for (const L of lands) { const d = Math.hypot(nx - L.x, ny - L.y); const rr = L.r * 1.25 + 0.9; if (d < rr) { nx = L.x + (nx - L.x) / d * rr; ny = L.y + (ny - L.y) / d * rr; const out = Math.atan2(ny - L.y, nx - L.x); let rel = Math.atan2(Math.sin(boat.h - out), Math.cos(boat.h - out)); const tan = out + (rel > 0 ? Math.PI / 2 : -Math.PI / 2); boat.h += Math.atan2(Math.sin(tan - boat.h), Math.cos(tan - boat.h)) * Math.min(1, dt * 6); boat.v *= 0.985; } } // 해안선에 닿으면 뱃머리를 해안선 방향으로 돌려 미끄러진다. 항해는 끊지 않는다
					const lim = WORLD / 2 - 6; nx = Math.max(-lim, Math.min(lim, nx)); ny = Math.max(-lim, Math.min(lim, ny));
					boat.x = nx; boat.y = ny;
					cam.x += (boat.x - cam.x) * Math.min(1, dt * 3); cam.y += (boat.y - cam.y) * Math.min(1, dt * 3);
					trailT += dt; if (trailT > 0.12 && boat.v > 0.5) { trailT = 0; trail.copyWithin(2, 0); trail[0] = boat.x - Math.cos(boat.h) * 1.2; trail[1] = boat.y - Math.sin(boat.h) * 1.2; reveal(boat.x, boat.y); }
					// 가까운 땅
					let best = null, bd = 1e9;
					for (const L of lands) { const d = Math.hypot(boat.x - L.x, boat.y - L.y) - L.r * 1.25; if (d < 3.2 && d < bd) { bd = d; best = L; } }
					if (best !== near) {
						near = best; if (near) intro.classList.add('off');
						if (near) {
							// 상륙: 닻 내리는 소리, 링, 등대 점등, 잠시 뒤 섬 화면
							sfx('anchor'); anchorAt = { x: boat.x, y: boat.y, t: (now - t0) / 1000 }; sailing = false; boat.v *= 0.3;
							if (!lit.has(near.id)) { lit.add(near.id); syncLit(); }
							// 순서대로 닿으면 항로가 한 구간 그려진다. 마지막 섬이면 완주
							if (near === nextIsle()) { stage++; syncRoute(); if (stage === route.length - 1) finish(); }
							say(near.id === 'S' ? 'yard' : route.slice(0, stage).includes(near) && near !== nextIsle() ? 'revisit' : 'land', true);
							clearTimeout(landT); const L = near; landT = setTimeout(() => { if (near === L) openIsle(L); }, 900);
						}
					}
					// 유리병 건지기: 편지를 펼친다
					if (!anyOpen()) for (const B of bottles) if (!got.has(B.id) && Math.hypot(boat.x - B.x, boat.y - B.y) < 2.2) { got.add(B.id); syncBottles(); chime(); if (B.kind === 1) say('letter', true); openLetter(B); break; } // 편지를 접으면 가던 길을 계속 간다
					// 다음 섬 나침반: 화면 밖에 있으면 가장자리에 방향을 띄운다
					const n = nextIsle();
					if (n && !near) {
						const [sx, sy] = toScreen(n.x, n.y), cx = innerWidth / 2, cy = innerHeight / 2, m = 56;
						const inside = sx > m && sx < innerWidth - m && sy > m && sy < innerHeight - m;
						if (!inside) { const vx = sx - cx, vy = sy - cy, s = Math.min((cx - m) / Math.abs(vx || 1e-6), (cy - m) / Math.abs(vy || 1e-6)); nextEl.style.left = `${cx + vx * s}px`; nextEl.style.top = `${cy + vy * s}px`; nextEl.firstElementChild.style.rotate = `${Math.atan2(vy, vx)}rad`; }
						nextEl.classList.toggle('on', !inside);
					} else nextEl.classList.remove('on');
					// 신기루: 다가가면 그만큼 물러난다
					if (mirage) {
						const mdx = mirage.x - boat.x, mdy = mirage.y - boat.y, mdist = Math.hypot(mdx, mdy);
						if (mdist < 15) { const ang = Math.atan2(mdy, mdx); let mx = boat.x + Math.cos(ang) * 24, my = boat.y + Math.sin(ang) * 24; if (Math.abs(mx) > 72 || Math.abs(my) > 72) { const a2 = Math.atan2(-boat.y, -boat.x) + Math.PI; mx = boat.x + Math.cos(a2 + 1.2) * 24; my = boat.y + Math.sin(a2 + 1.2) * 24; } mirage = { x: Math.max(-74, Math.min(74, mx)), y: Math.max(-74, Math.min(74, my)) }; if (now / 1000 - mirageT > 8) { mirageT = now / 1000; showToast('다음 섬', '가까워지면 멀어진다. 아직 안개 속이다.'); say('mirage'); } }
						const [sx, sy] = toScreen(mirage.x, mirage.y);
						mirEl.style.left = `${sx}px`; mirEl.style.top = `${sy - 40}px`; mirEl.classList.toggle('on', sx > 0 && sx < innerWidth && sy > 0 && sy < innerHeight);
					}
					const days = Math.floor((Date.now() - new Date(SAIL_FROM)) / 864e5);
					stat.textContent = `항해 ${days.toLocaleString()}일째 · ${boat.v.toFixed(1)} kn · 섬 ${NISL()}/${NR_ISL} · 편지 ${vals()}/${NVAL}`;
					mapT += dt; if (mapT > 0.2) { mapT = 0; drawMap(); }
				}
				function frame(now) {
					const dt = Math.min(0.05, (now - last) / 1000); last = now; step(dt, now);
					if (fogDirty) { gl.bindTexture(gl.TEXTURE_2D, tex); gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, fogC); fogData = fctx.getImageData(0, 0, 256, 256).data; fogDirty = false; }
					const t = (now - t0) / 1000;
					gl.uniform2f(U('R'), canvas.width, canvas.height); gl.uniform1f(U('T'), t);
					gl.uniform2f(U('CAM'), cam.x, cam.y); gl.uniform1f(U('ZOOM'), ZOOM); gl.uniform2f(U('BOAT'), boat.x, boat.y);
					gl.uniform2f(U('TGT'), sailing ? tgt.x : 1e4, sailing ? tgt.y : 1e4); gl.uniform2fv(U('TRAIL'), trail);
					gl.uniform2f(U('MON'), Math.cos(t * 0.05) * 66, Math.sin(t * 0.05) * 66); gl.uniform3f(U('MIR'), mirage ? mirage.x : 1e4, mirage ? mirage.y : 1e4, 0); gl.uniform3f(U('ANC'), anchorAt.x, anchorAt.y, anchorAt.t); // 가장자리를 천천히 도는 그림자, 신기루
					gl.drawArrays(gl.TRIANGLES, 0, 3); drawArt(t); requestAnimationFrame(frame);
				}
				requestAnimationFrame(frame);
			}
		</script>
	</body>
</html>
