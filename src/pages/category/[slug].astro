---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE, categorySlug } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const cats = [...new Set(posts.map((p) => p.data.category))];
	return cats.map((category) => ({
		params: { slug: categorySlug(category) },
		props: { category, posts: posts.filter((p) => p.data.category === category).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
	}));
}
const { category, posts } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${category} · ${SITE_TITLE}`} description={`${category} 글 ${posts.length}편`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{category}</h1>
			<CategoryNav current={category} />
			<PostList posts={posts} showCategory={false} />
		</main>
		<Footer />
	</body>
</html>
