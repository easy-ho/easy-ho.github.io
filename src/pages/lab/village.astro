---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { GITHUB_URL, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const places = [
	...posts.map((p, i) => ({ label: String(i + 1), name: p.data.title, sub: fmt(p.data.pubDate), href: `/blog/${p.id}/` })),
	{ label: 'A', name: '소개', sub: 'about', href: '/about/' },
	{ label: 'G', name: 'GitHub', sub: 'external', href: GITHUB_URL },
];

// 건물 배치: 3열, 건물 14×5, 간격 4
const COLS = 3, BW = 14, BH = 5, GAP = 4;
const rows = Math.ceil(places.length / COLS);
const W = COLS * BW + (COLS + 1) * GAP, H = rows * (BH + GAP) + GAP + 1;
const grid: string[][] = Array.from({ length: H }, () => new Array(W).fill(' '));
const doors: Record<string, number> = {};
places.forEach((pl, idx) => {
	const r = Math.floor(idx / COLS), c = idx % COLS;
	const x0 = GAP + c * (BW + GAP), y0 = GAP + r * (BH + GAP);
	for (let y = y0; y < y0 + BH; y++) for (let x = x0; x < x0 + BW; x++) {
		const edgeY = y === y0 || y === y0 + BH - 1, edgeX = x === x0 || x === x0 + BW - 1;
		grid[y][x] = edgeY && edgeX ? '+' : edgeY ? '-' : edgeX ? '|' : ' ';
	}
	const lab = `[${pl.label}]`;
	for (let k = 0; k < lab.length; k++) grid[y0 + 1][x0 + Math.floor((BW - lab.length) / 2) + k] = lab[k];
	const dx = x0 + Math.floor(BW / 2), dy = y0 + BH - 1;
	grid[dy][dx] = ' ';
	doors[`${dx},${dy}`] = idx;
});
// 길: 각 행 아래 점선
for (let r = 0; r <= rows; r++) { const y = r * (BH + GAP) + 2; if (y < H) for (let x = 1; x < W - 1; x += 2) grid[y][x] = '.'; }
const map = grid.map((r) => r.join(''));
const start = { x: Math.floor(W / 2), y: H - 2 };
const data = { map, doors, start, places };
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`village · ${SITE_TITLE}`} description="글이 건물인 ASCII 마을" />
		<style is:global>
			.wrap { overflow-x: auto; }
			pre.map { font-family: var(--mono); font-size: 0.78rem; line-height: 1.25; margin: 0; color: #9ca3af; user-select: none; display: inline-block; }
			.me { color: var(--text); font-weight: 700; background: #fef3c7; }
			.door { color: var(--text); }
			.lab { color: var(--text); font-weight: 650; }
			ol.legend { font-family: var(--mono); font-size: 0.82rem; list-style: none; padding: 0; margin: 1.2em 0 0; color: var(--muted); }
			ol.legend li { margin: 0.15em 0; }
			ol.legend li.near { color: var(--text); }
			ol.legend li.near::after { content: '  ⏎ 들어가기'; color: #b45309; }
			ol.legend b { display: inline-block; width: 3ch; font-weight: 650; color: var(--text); }
			.pad { display: none; grid-template-columns: repeat(3, 2.6em); gap: 0.3em; margin-top: 1em; }
			.pad button { font: inherit; height: 2.6em; border: 1px solid var(--line); background: none; border-radius: 6px; }
			@media (pointer: coarse) { .pad { display: grid; } }
			.hint { color: var(--muted); font-size: 0.85rem; margin-top: 1.5em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrap"><pre class="map" id="map"></pre></div>
			<ol class="legend" id="legend">{places.map((p, i) => <li data-i={i}><b>[{p.label}]</b> <span class="muted">{p.sub}</span>  {p.name}</li>)}</ol>
			<div class="pad">
				<span></span><button data-d="0,-1">▲</button><span></span>
				<button data-d="-1,0">◀</button><button id="enter">⏎</button><button data-d="1,0">▶</button>
				<span></span><button data-d="0,1">▼</button><span></span>
			</div>
			<p class="hint">방향키나 hjkl로 @를 움직인다. 건물 아래 뚫린 문 앞에 서면 Enter로 들어간다. 글이 늘면 건물이 자동으로 생긴다.</p>
		</main>
		<Footer />
		<script define:vars={{ data }}>
			const { map, doors, start, places } = data;
			const el = document.getElementById('map'), legend = document.getElementById('legend');
			let me = { ...start }, near = -1;
			const esc = (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] || c);
			function draw() {
				let out = '';
				for (let y = 0; y < map.length; y++) {
					for (let x = 0; x < map[y].length; x++) {
						const ch = map[y][x];
						if (x === me.x && y === me.y) out += '<span class="me">@</span>';
						else if (doors[`${x},${y}`] !== undefined) out += '<span class="door">▯</span>';
						else if (ch === '[' || ch === ']' || /[0-9AG]/.test(ch) && map[y][x - 1] === '[') out += `<span class="lab">${ch}</span>`;
						else out += esc(ch);
					}
					out += '\n';
				}
				el.innerHTML = out;
				near = doors[`${me.x},${me.y}`] ?? -1;
				[...legend.children].forEach((li) => li.classList.toggle('near', +li.dataset.i === near));
			}
			function move(dx, dy) {
				const nx = me.x + dx, ny = me.y + dy;
				if (ny < 0 || ny >= map.length || nx < 0 || nx >= map[ny].length) return;
				const ch = map[ny][nx];
				if ('+-|'.includes(ch)) return;
				if (ch !== ' ' && ch !== '.') return;
				// 건물 안으로는 못 들어감: 문 칸만 허용
				if (insideBuilding(nx, ny) && doors[`${nx},${ny}`] === undefined) return;
				me = { x: nx, y: ny }; draw();
			}
			function insideBuilding(x, y) {
				let left = false, right = false;
				for (let i = x - 1; i >= 0; i--) if (map[y][i] === '|') { left = true; break; } else if (map[y][i] === '.' ) break;
				for (let i = x + 1; i < map[y].length; i++) if (map[y][i] === '|') { right = true; break; } else if (map[y][i] === '.') break;
				return left && right;
			}
			function enter() { if (near >= 0) location.href = places[near].href; }
			const keys = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0], k: [0, -1], j: [0, 1], h: [-1, 0], l: [1, 0] };
			addEventListener('keydown', (e) => {
				if (keys[e.key]) { e.preventDefault(); move(...keys[e.key]); }
				else if (e.key === 'Enter') enter();
			});
			document.querySelectorAll('.pad [data-d]').forEach((b) => b.onclick = () => move(...b.dataset.d.split(',').map(Number)));
			document.getElementById('enter').onclick = enter;
			draw();
		</script>
	</body>
</html>
