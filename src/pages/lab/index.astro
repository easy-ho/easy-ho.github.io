---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const labs = [
	{ href: '/lab/log/', name: 'log', desc: '홈이 진짜 로그 파일. git 히스토리가 그대로 INFO/DEBUG/WARN 줄이 된다.' },
	{ href: '/lab/replay/', name: 'replay', desc: '글이 초고에서 지금까지 고쳐진 과정을 diff로 재생한다.' },
	{ href: '/lab/village/', name: 'village', desc: '글이 건물인 ASCII 마을. @를 움직여 문으로 들어간다.' },
	{ href: '/lab/gate/', name: 'gate', desc: 'sudo 농담 한 줄과 진짜 빌드 정보를 지나서 들어가는 입장 장면.' },
	{ href: '/lab/terminal/', name: 'terminal', desc: '평소엔 보통 홈. 아무 키나 치면 아래에서 셸이 올라온다.' },
	{ href: '/lab/status/', name: 'status', desc: 'GitHub 활동 시각으로 바뀌는 지금 상태 얼굴.' },
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`lab · ${SITE_TITLE}`} description="홈 장치 시제품" />
		<style>
			ul { list-style: none; padding: 0; }
			li { padding: 0.6em 0; border-bottom: 1px solid var(--line); }
			li a { font-family: var(--mono); font-weight: 650; text-decoration: none; }
			li span { display: block; color: var(--muted); font-size: 0.9rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>lab</h1>
			<p class="muted">홈에 붙일 장치 후보들. 하나 고르면 그걸 홈으로 옮긴다.</p>
			<ul>{labs.map((l) => <li><a href={l.href}>{l.name}</a><span>{l.desc}</span></li>)}</ul>
		</main>
		<Footer />
	</body>
</html>
