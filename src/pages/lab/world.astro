---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
// 비석: 길(z축)을 따라 최신 글부터 과거로. 높이는 글 분량.
const mons = posts.map((p, i) => {
	const words = (p.body ?? '').replace(/<[^>]+>/g, '').length;
	return {
		x: i % 2 === 0 ? -2.6 : 2.6,
		z: 18 + i * 22,
		h: Math.min(7, 1.8 + words / 900),
		w: 0.55,
		title: p.data.title,
		date: fmt(p.data.pubDate),
		href: `/blog/${p.id}/`,
	};
});
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`world · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			html, body { height: 100%; overflow: hidden; background: #fff; }
			#gl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
			.hud { position: fixed; inset: 0; pointer-events: none; font-family: var(--font); }
			.hud .top { position: absolute; top: calc(1.2rem + env(safe-area-inset-top, 0px)); left: 1.25rem; right: 1.25rem; display: flex; justify-content: space-between; align-items: baseline; pointer-events: auto; }
			.hud .brand { font-weight: 700; text-decoration: none; font-size: 1.05rem; color: var(--text); }
			.hud .links { display: flex; gap: 1.2em; font-size: 0.95rem; }
			.hud .links a { text-decoration: none; color: var(--muted); }
			.hud.night .brand, .hud.night .links a { color: #e5e7eb; }
			.dot { position: absolute; left: 50%; top: 50%; width: 5px; height: 5px; margin: -2.5px; border-radius: 50%; background: currentColor; opacity: 0.6; }
			.hud { color: #1f2328; } .hud.night { color: #f3f4f6; }
			.near { position: absolute; left: 50%; bottom: 22%; transform: translateX(-50%); text-align: center; opacity: 0; transition: opacity 0.25s; pointer-events: auto; }
			.near.on { opacity: 1; }
			.near .t { font-size: clamp(1.2rem, 3.4vw, 1.8rem); font-weight: 800; letter-spacing: -0.02em; text-decoration: none; color: inherit; }
			.near .d { font-family: var(--mono); font-size: 0.85rem; opacity: 0.7; margin-top: 0.3em; }
			.near .k { font-family: var(--mono); font-size: 0.8rem; margin-top: 0.8em; opacity: 0.8; }
			.help { position: absolute; left: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.6; }
			.pos { position: absolute; right: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.6; text-align: right; }
			.intro { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; pointer-events: auto; cursor: pointer; }
			.intro h1 { font-size: clamp(2.4rem, 7vw, 4rem); letter-spacing: -0.03em; margin: 0 0 0.2em; font-weight: 800; }
			.intro p { margin: 0; opacity: 0.7; }
			.intro .go { margin-top: 2em; font-family: var(--mono); font-size: 0.85rem; opacity: 0.8; animation: pulse 1.6s ease-in-out infinite; }
			@keyframes pulse { 50% { opacity: 0.3; } }
			.intro.off { display: none; }
			.stick { position: absolute; left: 1.25rem; bottom: 4.5rem; width: 110px; height: 110px; border-radius: 50%; border: 1px solid currentColor; opacity: 0.35; display: none; pointer-events: auto; }
			.stick i { position: absolute; left: 50%; top: 50%; width: 44px; height: 44px; margin: -22px; border-radius: 50%; background: currentColor; }
			@media (pointer: coarse) { .stick { display: block; } .help { display: none; } }
			.fallback { max-width: 660px; margin: 4rem auto; padding: 0 1.25rem; display: none; }
		</style>
	</head>
	<body>
		<canvas id="gl"></canvas>
		<div class="hud" id="hud">
			<div class="top">
				<a class="brand" href="/">{SITE_TITLE}</a>
				<div class="links"><a href="/blog">글</a><a href="/about">소개</a></div>
			</div>
			<div class="intro" id="intro">
				<div>
					<h1>easyho.log</h1>
					<p>글 하나가 비석 하나. 길을 따라 걸으면 과거로 간다.</p>
					<div class="go">클릭해서 들어가기</div>
				</div>
			</div>
			<div class="dot"></div>
			<div class="near" id="near"><a class="t" id="nt" href="#"></a><div class="d" id="nd"></div><div class="k">E · 읽기</div></div>
			<div class="help">W A S D 이동 · 마우스 둘러보기 · E 읽기 · Esc 나가기</div>
			<div class="pos" id="pos"></div>
			<div class="stick" id="stick"><i></i></div>
		</div>
		<div class="fallback" id="fallback">
			<p class="muted">WebGL2를 쓸 수 없는 환경이라 목록으로 보여준다.</p>
			<ul class="post-list">{mons.map((m) => <li><span>{m.date}</span><a href={m.href}>{m.title}</a></li>)}</ul>
		</div>
		<script define:vars={{ mons }}>
			const canvas = document.getElementById('gl');
			const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'high-performance' });
			if (!gl) { document.getElementById('fallback').style.display = 'block'; document.getElementById('hud').style.display = 'none'; canvas.remove(); document.body.style.overflow = 'auto'; }
			else {
				const MAXM = 32;
				const vs = `#version 300 es
				void main(){ vec2 v = vec2((gl_VertexID<<1)&2, gl_VertexID&2); gl_Position = vec4(v*2.-1.,0.,1.); }`;
				const fs = `#version 300 es
				precision highp float;
				out vec4 o;
				uniform vec2 R; uniform float T; uniform vec3 C; uniform vec2 A; uniform float DAY; uniform int NM; uniform int NEAR; uniform vec4 MON[${MAXM}];
				float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
				float sdBox(vec3 p, vec3 b){ vec3 d=abs(p)-b; return length(max(d,0.))+min(max(d.x,max(d.y,d.z)),0.); }
				float pillar(vec3 p, vec2 cell){
					float h = hash(cell);
					if (h < 0.45 || cell.x == -1. || cell.x == 0.) return 1e3;
					float ht = 0.6 + 7.*hash(cell+7.3);
					float w  = 0.12 + 0.5*hash(cell+3.1);
					return sdBox(p - vec3((cell.x+0.5)*5., ht, (cell.y+0.5)*5.), vec3(w, ht, w));
				}
				// 반환: x=거리, y=재질(0 바닥, 1 기둥, 2 비석, 3 가까운 비석)
				vec2 map(vec3 p){
					vec2 cell = floor(p.xz/5.);
					float d = 1e3;
					for (int i=-1;i<=1;i++) for (int j=-1;j<=1;j++) d = min(d, pillar(p, cell+vec2(i,j)));
					vec2 r = vec2(d, 1.);
					for (int i=0;i<NM;i++){
						vec4 m = MON[i];
						float b = sdBox(p - vec3(m.x, m.z*0.5, m.y), vec3(m.w, m.z*0.5, m.w*0.35)) - 0.03;
						if (b < r.x) r = vec2(b, i==NEAR ? 3. : 2.);
					}
					if (p.y < r.x) r = vec2(p.y, 0.);
					return r;
				}
				vec3 normal(vec3 p){ vec2 e=vec2(1e-3,0.); return normalize(vec3(map(p+e.xyy).x-map(p-e.xyy).x, map(p+e.yxy).x-map(p-e.yxy).x, map(p+e.yyx).x-map(p-e.yyx).x)); }
				float shadow(vec3 ro, vec3 rd){ float r=1., t=0.05; for(int i=0;i<36;i++){ float h=map(ro+rd*t).x; if(h<1e-3) return 0.; r=min(r, 8.*h/t); t+=clamp(h,0.05,0.7); if(t>28.) break; } return clamp(r,0.,1.); }
				float ao(vec3 p, vec3 n){ float a=0., s=1.; for(int i=1;i<=5;i++){ float d=0.12*float(i); a += s*(d-map(p+n*d).x); s*=0.6; } return clamp(1.-2.*a,0.,1.); }
				void main(){
					vec2 uv = (gl_FragCoord.xy*2.-R)/R.y;
					float cy = cos(A.x), sy = sin(A.x), cp = cos(A.y), sp = sin(A.y);
					vec3 f = normalize(vec3(sy*cp, sp, cy*cp));
					vec3 r = normalize(cross(vec3(0,1,0), f)), u = cross(f, r);
					vec3 rd = normalize(uv.x*r + uv.y*u + 1.5*f);
					vec3 ro = C;
					float t=0.; vec2 m; bool hit=false;
					for(int i=0;i<100;i++){ m = map(ro+rd*t); if(m.x<2e-4*t){ hit=true; break; } if(t>80.) break; t += m.x*0.9; }
					// 하늘: 낮은 흰색, 밤은 짙은 남색
					vec3 skyDay = vec3(1.), skyNight = vec3(0.05,0.06,0.10);
					vec3 sky = mix(skyNight, skyDay, DAY);
					vec3 col = sky;
					if (!hit && DAY < 0.5) { // 별
						vec2 sp2 = floor(rd.xz/rd.y*150.); float s = hash(sp2); if (rd.y > 0.05 && s > 0.993) col += (1.-DAY*2.)*vec3(0.9)*smoothstep(0.993,1.,s); }
					if (hit) {
						vec3 p = ro+rd*t, n = normal(p);
						vec3 L = normalize(mix(vec3(-0.3,0.35,0.2), vec3(0.45,0.75,-0.35), DAY));
						float dif = clamp(dot(n,L),0.,1.) * shadow(p+n*2e-3, L);
						float occ = ao(p,n);
						float amb = 0.55 + 0.45*n.y;
						vec3 base = m.y < 0.5 ? vec3(0.93,0.94,0.96) : m.y < 1.5 ? vec3(0.78,0.80,0.84) : vec3(0.22,0.23,0.26);
						if (m.y < 0.5) { vec2 g = abs(fract(p.xz/5.)-0.5); float l = smoothstep(0.02,0.0,min(g.x,g.y)); base = mix(base, vec3(0.85), l*0.5);
							float road = smoothstep(4.9,4.6,abs(p.x)); base = mix(base, vec3(0.88,0.89,0.91), road*0.6); }
						vec3 lit = base*(amb*occ*0.75 + dif*0.55);
						vec3 nightLit = base*(0.10 + 0.08*n.y)*occ + base*dif*0.12;
						col = mix(nightLit, lit, DAY);
						if (m.y > 1.5) { // 비석: 가장자리 발광
							vec3 glow = m.y > 2.5 ? vec3(1.0,0.78,0.35) : vec3(0.55,0.65,0.9);
							float edge = 1.-abs(dot(n, -rd)); edge = pow(edge, 3.);
							float pulse = m.y > 2.5 ? 0.75+0.25*sin(T*3.) : 0.35;
							col += glow * (edge*0.8 + 0.08) * pulse * mix(1.4, 0.5, DAY);
						}
						float fog = 1.-exp(-0.03*t);
						col = mix(col, sky, fog);
					}
					col *= 1. - 0.18*dot(uv*0.55, uv*0.55);
					o = vec4(col, 1.);
				}`;
				const prog = gl.createProgram();
				for (const [type, src] of [[gl.VERTEX_SHADER, vs], [gl.FRAGMENT_SHADER, fs]]) {
					const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
					if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
					gl.attachShader(prog, s);
				}
				gl.linkProgram(prog); gl.useProgram(prog);
				const U = (n) => gl.getUniformLocation(prog, n);
				const uR = U('R'), uT = U('T'), uC = U('C'), uA = U('A'), uDAY = U('DAY'), uNM = U('NM'), uNEAR = U('NEAR'), uMON = U('MON');
				const monArr = new Float32Array(MAXM * 4);
				mons.slice(0, MAXM).forEach((m, i) => { monArr[i * 4] = m.x; monArr[i * 4 + 1] = m.z; monArr[i * 4 + 2] = m.h; monArr[i * 4 + 3] = m.w; });
				gl.uniform4fv(uMON, monArr); gl.uniform1i(uNM, Math.min(mons.length, MAXM));

				// 낮밤: 방문자 현지 시각. 6시·19시 전후로 부드럽게.
				const hour = new Date().getHours() + new Date().getMinutes() / 60;
				const day = Math.min(1, Math.max(0, (hour - 5.5) / 1.5)) * Math.min(1, Math.max(0, (20 - hour) / 1.5));
				gl.uniform1f(uDAY, day);
				const hud = document.getElementById('hud'); if (day < 0.5) hud.classList.add('night');

				const scale = Math.min(devicePixelRatio, 2) * (innerWidth < 700 ? 0.42 : 0.5);
				function resize() { canvas.width = Math.floor(innerWidth * scale); canvas.height = Math.floor(innerHeight * scale); gl.viewport(0, 0, canvas.width, canvas.height); }
				addEventListener('resize', resize); resize();

				// 플레이어
				const cam = { x: 0, y: 1.6, z: 2 }, ang = { yaw: 0, pitch: 0 };
				const keys = new Set();
				let locked = false, near = -1;
				const intro = document.getElementById('intro'), nearEl = document.getElementById('near'), nt = document.getElementById('nt'), nd = document.getElementById('nd'), posEl = document.getElementById('pos');
				const coarse = matchMedia('(pointer: coarse)').matches;
				intro.addEventListener('click', () => { intro.classList.add('off'); if (!coarse) canvas.requestPointerLock?.(); });
				canvas.addEventListener('click', () => { if (!coarse && !locked) canvas.requestPointerLock?.(); });
				document.addEventListener('pointerlockchange', () => { locked = document.pointerLockElement === canvas; });
				addEventListener('mousemove', (e) => { if (!locked) return; ang.yaw += e.movementX * 0.0022; ang.pitch = Math.max(-1.2, Math.min(1.2, ang.pitch - e.movementY * 0.0022)); });
				addEventListener('keydown', (e) => { keys.add(e.key.toLowerCase()); if (e.key.toLowerCase() === 'e' && near >= 0) location.href = mons[near].href; });
				addEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));

				// 터치: 왼쪽 스틱 이동, 나머지 영역 드래그로 둘러보기
				const stick = document.getElementById('stick'), knob = stick.querySelector('i');
				let stickV = { x: 0, y: 0 }, stickId = null, lookId = null, lookLast = null;
				stick.addEventListener('pointerdown', (e) => { stickId = e.pointerId; stick.setPointerCapture(e.pointerId); });
				stick.addEventListener('pointermove', (e) => { if (e.pointerId !== stickId) return; const r = stick.getBoundingClientRect(); let dx = (e.clientX - r.left - r.width / 2) / (r.width / 2), dy = (e.clientY - r.top - r.height / 2) / (r.height / 2); const l = Math.hypot(dx, dy); if (l > 1) { dx /= l; dy /= l; } stickV = { x: dx, y: dy }; knob.style.transform = `translate(${dx * 30}px,${dy * 30}px)`; });
				const stickEnd = (e) => { if (e.pointerId !== stickId) return; stickId = null; stickV = { x: 0, y: 0 }; knob.style.transform = ''; };
				stick.addEventListener('pointerup', stickEnd); stick.addEventListener('pointercancel', stickEnd);
				canvas.addEventListener('pointerdown', (e) => { if (e.pointerType === 'touch') { lookId = e.pointerId; lookLast = { x: e.clientX, y: e.clientY }; } });
				canvas.addEventListener('pointermove', (e) => { if (e.pointerId !== lookId) return; ang.yaw += (e.clientX - lookLast.x) * 0.005; ang.pitch = Math.max(-1.2, Math.min(1.2, ang.pitch - (e.clientY - lookLast.y) * 0.005)); lookLast = { x: e.clientX, y: e.clientY }; });
				canvas.addEventListener('pointerup', (e) => { if (e.pointerId === lookId) lookId = null; });
				nt.addEventListener('click', (e) => { e.preventDefault(); if (near >= 0) location.href = mons[near].href; });

				const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
				let last = performance.now();
				const t0 = last;
				function step(dt) {
					let fw = 0, sd = 0;
					if (keys.has('w') || keys.has('arrowup')) fw += 1; if (keys.has('s') || keys.has('arrowdown')) fw -= 1;
					if (keys.has('d') || keys.has('arrowright')) sd += 1; if (keys.has('a') || keys.has('arrowleft')) sd -= 1;
					fw += -stickV.y; sd += stickV.x;
					const sp = (keys.has('shift') ? 9 : 5) * dt;
					const fx = Math.sin(ang.yaw), fz = Math.cos(ang.yaw);
					let nx = cam.x + (fx * fw + fz * sd) * sp, nz = cam.z + (fz * fw - fx * sd) * sp;
					nx = Math.max(-4.4, Math.min(4.4, nx)); nz = Math.max(-2, nz);
					// 비석 충돌
					for (const m of mons) { const dx = nx - m.x, dz = nz - m.z; const rx = m.w + 0.45, rz = m.w * 0.35 + 0.45; if (Math.abs(dx) < rx && Math.abs(dz) < rz) { if (Math.abs(dx) / rx > Math.abs(dz) / rz) nx = m.x + Math.sign(dx) * rx; else nz = m.z + Math.sign(dz) * rz; } }
					cam.x = nx; cam.z = nz;
					cam.y = 1.6 + Math.sin((performance.now() - t0) / 90) * 0.02 * Math.min(1, Math.hypot(fw, sd));
					let best = -1, bd = 4.2;
					mons.forEach((m, i) => { const d = Math.hypot(cam.x - m.x, cam.z - m.z); if (d < bd) { bd = d; best = i; } });
					if (best !== near) { near = best; nearEl.classList.toggle('on', near >= 0); if (near >= 0) { nt.textContent = mons[near].title; nt.href = mons[near].href; nd.textContent = mons[near].date; } }
					posEl.textContent = `z ${cam.z.toFixed(0)}  ·  ${mons.length}개의 비석`;
				}
				function frame(now) {
					const dt = Math.min(0.05, (now - last) / 1000); last = now;
					step(dt);
					gl.uniform2f(uR, canvas.width, canvas.height);
					gl.uniform1f(uT, reduced ? 0 : (now - t0) / 1000);
					gl.uniform3f(uC, cam.x, cam.y, cam.z); gl.uniform2f(uA, ang.yaw, ang.pitch); gl.uniform1i(uNEAR, near);
					gl.drawArrays(gl.TRIANGLES, 0, 3);
					requestAnimationFrame(frame);
				}
				requestAnimationFrame(frame);
			}
		</script>
	</body>
</html>
