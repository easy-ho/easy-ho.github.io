---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`world · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			body { background: #fff; }
			#gl { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; display: block; }
			header { position: relative; z-index: 2; }
			.hero { min-height: 92vh; display: flex; flex-direction: column; justify-content: center; max-width: 660px; margin: 0 auto; padding: 0 1.25rem; }
			.hero h1 { font-size: clamp(2.4rem, 7vw, 4rem); letter-spacing: -0.03em; margin: 0 0 0.3em; font-weight: 800; }
			.hero p { color: var(--muted); font-size: 1.05rem; margin: 0; }
			.hero .dn { margin-top: 3em; color: #9ca3af; font-size: 0.85rem; font-family: var(--mono); }
			@supports (animation-timeline: scroll()) {
				.hero { animation: fade linear both; animation-timeline: scroll(); animation-range: 0 60vh; }
				@keyframes fade { to { opacity: 0; transform: translateY(-30px); } }
			}
			main.list { background: rgba(255,255,255,0.78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 14px; margin-top: 10vh; margin-bottom: 20vh; padding: 2rem 1.5rem; }
			main.list h2 { margin-top: 0; font-size: 1rem; color: var(--muted); font-weight: 600; }
			.stack { font-family: var(--mono); font-size: 0.78rem; color: #9ca3af; margin: 3em 0 0; }
			footer { position: relative; z-index: 2; }
		</style>
	</head>
	<body>
		<canvas id="gl"></canvas>
		<Header />
		<section class="hero">
			<h1>easyho.log</h1>
			<p>백엔드 개발자. 일하면서 겪은 삽질, 설계, 자동화 이야기를 적는다.</p>
			<div class="dn">↓ scroll</div>
		</section>
		<main class="list">
			<h2>글</h2>
			<ul class="post-list">
				{posts.map((post) => (
					<li><FormattedDate date={post.data.pubDate} /><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
				))}
			</ul>
			<p class="stack">배경: 이미지 0장, 3D 라이브러리 0개. 프래그먼트 셰이더 하나가 매 프레임 레이마칭으로 그린다. 스크롤이 카메라를 움직이고, CSS scroll-driven animation이 제목을 지운다.</p>
		</main>
		<Footer />
		<script>
			const canvas = document.getElementById('gl') as HTMLCanvasElement;
			const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'high-performance' });
			if (!gl) { canvas.style.background = 'linear-gradient(#fff, #eef0f3)'; }
			else {
				const vs = `#version 300 es
				void main(){ vec2 v = vec2((gl_VertexID<<1)&2, gl_VertexID&2); gl_Position = vec4(v*2.-1.,0.,1.); }`;
				const fs = `#version 300 es
				precision highp float;
				out vec4 o;
				uniform vec2 R; uniform float T; uniform vec2 M; uniform float S;
				float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
				float sdBox(vec3 p, vec3 b){ vec3 d=abs(p)-b; return length(max(d,0.))+min(max(d.x,max(d.y,d.z)),0.); }
				// 세계: 바닥 + 격자마다 확률적으로 서 있는 기둥. 가운데 복도는 비워 둔다.
				// 주변 3x3 칸의 기둥을 전부 평가해 반복 도메인 경계에서 생기는 건너뜀을 막는다.
				float pillar(vec3 p, vec2 cell){
					float h = hash(cell);
					if (h < 0.42 || cell.x == -1. || cell.x == 0.) return 1e3;
					float ht = 0.6 + 7.*hash(cell+7.3);
					float w  = 0.12 + 0.5*hash(cell+3.1);
					vec3 q = p - vec3((cell.x+0.5)*5., ht, (cell.y+0.5)*5.);
					return sdBox(q, vec3(w, ht, w));
				}
				vec2 map(vec3 p){
					vec2 cell = floor(p.xz/5.);
					float box = 1e3;
					for (int i=-1;i<=1;i++) for (int j=-1;j<=1;j++) box = min(box, pillar(p, cell+vec2(i,j)));
					return p.y < box ? vec2(p.y, 0.) : vec2(box, 1.);
				}
				vec3 normal(vec3 p){ vec2 e=vec2(1e-3,0.); return normalize(vec3(map(p+e.xyy).x-map(p-e.xyy).x, map(p+e.yxy).x-map(p-e.yxy).x, map(p+e.yyx).x-map(p-e.yyx).x)); }
				float shadow(vec3 ro, vec3 rd){ float r=1., t=0.05; for(int i=0;i<40;i++){ float h=map(ro+rd*t).x; if(h<1e-3) return 0.; r=min(r, 10.*h/t); t+=clamp(h,0.05,0.6); if(t>30.) break; } return clamp(r,0.,1.); }
				float ao(vec3 p, vec3 n){ float a=0., s=1.; for(int i=1;i<=5;i++){ float d=0.12*float(i); a += s*(d-map(p+n*d).x); s*=0.6; } return clamp(1.-2.*a,0.,1.); }
				void main(){
					vec2 uv = (gl_FragCoord.xy*2.-R)/R.y;
					vec3 ro = vec3(0.35*M.x, 1.5 + 0.25*M.y, T*0.5 + S*60.);
					vec3 ta = ro + vec3(0.35*M.x, 0.2*M.y - 0.08, 1.);
					vec3 f = normalize(ta-ro), r = normalize(cross(vec3(0,1,0), f)), u = cross(f, r);
					vec3 rd = normalize(uv.x*r + uv.y*u + 1.7*f);
					float t=0.; vec2 m; bool hit=false;
					for(int i=0;i<110;i++){ m = map(ro+rd*t); if(m.x<2e-4*t){ hit=true; break; } if(t>90.) break; t += m.x*0.9; }
					vec3 sky = vec3(1.);
					vec3 col = sky;
					if (hit) {
						vec3 p = ro+rd*t, n = normal(p);
						vec3 L = normalize(vec3(0.45, 0.75, -0.35));
						float dif = clamp(dot(n,L),0.,1.) * shadow(p+n*2e-3, L);
						float amb = 0.55 + 0.45*n.y;
						float occ = ao(p,n);
						vec3 base = m.y < 0.5 ? vec3(0.93,0.94,0.96) : vec3(0.78,0.80,0.84);
						// 바닥 가는 격자선
						if (m.y < 0.5) { vec2 g = abs(fract(p.xz/5.)-0.5); float l = smoothstep(0.02,0.0,min(g.x,g.y)); base = mix(base, vec3(0.85), l*0.5); }
						col = base*(amb*occ*0.75 + dif*0.55) + vec3(0.03,0.04,0.07)*(1.-occ);
						float fog = 1.-exp(-0.028*t);
						col = mix(col, sky, fog);
					}
					// 비네트
					col *= 1. - 0.18*dot(uv*0.55, uv*0.55);
					o = vec4(col, 1.);
				}`;
				const prog = gl.createProgram()!;
				for (const [type, src] of [[gl.VERTEX_SHADER, vs], [gl.FRAGMENT_SHADER, fs]] as const) {
					const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s);
					if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
					gl.attachShader(prog, s);
				}
				gl.linkProgram(prog); gl.useProgram(prog);
				const uR = gl.getUniformLocation(prog, 'R'), uT = gl.getUniformLocation(prog, 'T'), uM = gl.getUniformLocation(prog, 'M'), uS = gl.getUniformLocation(prog, 'S');
				const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
				const scale = Math.min(devicePixelRatio, 2) * (innerWidth < 700 ? 0.45 : 0.55);
				let mx = 0, my = 0, tx = 0, ty = 0, scroll = 0;
				function resize() { canvas.width = Math.floor(innerWidth * scale); canvas.height = Math.floor(innerHeight * scale); gl.viewport(0, 0, canvas.width, canvas.height); }
				addEventListener('resize', resize); resize();
				addEventListener('pointermove', (e) => { tx = (e.clientX / innerWidth) * 2 - 1; ty = 1 - (e.clientY / innerHeight) * 2; });
				addEventListener('scroll', () => { scroll = scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight); }, { passive: true });
				const t0 = performance.now();
				function frame() {
					mx += (tx - mx) * 0.05; my += (ty - my) * 0.05;
					gl.uniform2f(uR, canvas.width, canvas.height);
					gl.uniform1f(uT, reduced ? 0 : (performance.now() - t0) / 1000);
					gl.uniform2f(uM, mx, my); gl.uniform1f(uS, scroll);
					gl.drawArrays(gl.TRIANGLES, 0, 3);
					if (!reduced) requestAnimationFrame(frame);
				}
				frame();
			}
		</script>
	</body>
</html>
