---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const words = ['easyho.log', ...posts.map((p) => p.data.title)];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`particles · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			.hero { position: relative; height: 68vh; min-height: 380px; }
			#gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
			.hero .cap { position: absolute; left: 0; right: 0; bottom: 1.2rem; text-align: center; color: #9ca3af; font-family: var(--mono); font-size: 0.78rem; pointer-events: none; }
			main { padding-top: 1rem; }
			.stack { font-family: var(--mono); font-size: 0.78rem; color: #9ca3af; margin: 3em 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<div class="hero">
			<canvas id="gl"></canvas>
			<div class="cap" id="cap"></div>
		</div>
		<main>
			<p class="muted">백엔드 개발자. 일하면서 겪은 삽질, 설계, 자동화 이야기를 적는다.</p>
			<ul class="post-list">
				{posts.map((post) => (
					<li><FormattedDate date={post.data.pubDate} /><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
				))}
			</ul>
			<p class="stack">위: 입자 4만 개. 글 제목을 캔버스에 그려 픽셀을 샘플링한 자리로 각 입자가 스프링처럼 끌려가고, 포인터가 닿으면 밀려난다. WebGL2 포인트 렌더링.</p>
		</main>
		<Footer />
		<script define:vars={{ words }}>
			const canvas = document.getElementById('gl'), cap = document.getElementById('cap');
			const gl = canvas.getContext('webgl2', { alpha: true, antialias: false });
			if (gl) {
				const N = 40000, dpr = Math.min(devicePixelRatio, 2);
				let W = 0, H = 0;
				const pos = new Float32Array(N * 2), vel = new Float32Array(N * 2), tgt = new Float32Array(N * 2);
				const seed = new Float32Array(N); for (let i = 0; i < N; i++) seed[i] = Math.random();

				const vs = `#version 300 es
				in vec2 p; in float s; uniform vec2 R; uniform float dpr; out float a;
				void main(){ gl_Position = vec4(p/R*2.-1., 0., 1.); gl_Position.y = -gl_Position.y; gl_PointSize = (1.1 + 1.2*s)*dpr; a = 0.35 + 0.45*s; }`;
				const fs = `#version 300 es
				precision mediump float; in float a; out vec4 o;
				void main(){ vec2 c = gl_PointCoord-0.5; if (dot(c,c) > 0.25) discard; o = vec4(0.12,0.14,0.16, a); }`;
				const prog = gl.createProgram();
				for (const [t, src] of [[gl.VERTEX_SHADER, vs], [gl.FRAGMENT_SHADER, fs]]) { const sh = gl.createShader(t); gl.shaderSource(sh, src); gl.compileShader(sh); if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(sh)); gl.attachShader(prog, sh); }
				gl.linkProgram(prog); gl.useProgram(prog);
				gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
				const bp = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, bp); gl.bufferData(gl.ARRAY_BUFFER, pos, gl.DYNAMIC_DRAW);
				const lp = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(lp); gl.vertexAttribPointer(lp, 2, gl.FLOAT, false, 0, 0);
				const bs = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, bs); gl.bufferData(gl.ARRAY_BUFFER, seed, gl.STATIC_DRAW);
				const ls = gl.getAttribLocation(prog, 's'); gl.enableVertexAttribArray(ls); gl.vertexAttribPointer(ls, 1, gl.FLOAT, false, 0, 0);
				const uR = gl.getUniformLocation(prog, 'R'), uD = gl.getUniformLocation(prog, 'dpr');

				// 글자를 2D 캔버스에 그려 픽셀 좌표를 뽑는다
				const off = document.createElement('canvas'), ctx = off.getContext('2d', { willReadFrequently: true });
				function targetsFor(text) {
					off.width = W; off.height = H; ctx.clearRect(0, 0, W, H);
					let size = Math.min(W * 0.11, H * 0.32);
					ctx.font = `800 ${size}px 'Pretendard Variable', Pretendard, sans-serif`;
					while (ctx.measureText(text).width > W * 0.86 && size > 10) { size *= 0.92; ctx.font = `800 ${size}px 'Pretendard Variable', Pretendard, sans-serif`; }
					ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = '#000';
					ctx.fillText(text, W / 2, H / 2);
					const d = ctx.getImageData(0, 0, W, H).data, pts = [];
					const step = Math.max(1, Math.round(Math.sqrt((W * H) / 220000)));
					for (let y = 0; y < H; y += step) for (let x = 0; x < W; x += step) if (d[(y * W + x) * 4 + 3] > 128) pts.push(x, y);
					return pts;
				}
				let wi = 0;
				function retarget() {
					const pts = targetsFor(words[wi]);
					cap.textContent = `${wi + 1} / ${words.length}`;
					const M = pts.length / 2;
					for (let i = 0; i < N; i++) { const k = (i * 7919) % M; tgt[i * 2] = pts[k * 2] + (Math.random() - 0.5) * 1.5; tgt[i * 2 + 1] = pts[k * 2 + 1] + (Math.random() - 0.5) * 1.5; }
					wi = (wi + 1) % words.length;
				}
				function resize() {
					W = Math.floor(canvas.clientWidth * dpr); H = Math.floor(canvas.clientHeight * dpr);
					canvas.width = W; canvas.height = H; gl.viewport(0, 0, W, H);
					for (let i = 0; i < N * 2; i += 2) { pos[i] = Math.random() * W; pos[i + 1] = Math.random() * H; }
					retarget();
				}
				let mx = -1e4, my = -1e4;
				canvas.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); mx = (e.clientX - r.left) * dpr; my = (e.clientY - r.top) * dpr; });
				canvas.addEventListener('pointerleave', () => { mx = my = -1e4; });
				canvas.addEventListener('click', retarget);
				const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
				function frame() {
					const R2 = (70 * dpr) ** 2;
					for (let i = 0; i < N; i++) {
						const ix = i * 2, iy = ix + 1;
						const k = 0.015 + 0.02 * seed[i];
						vel[ix] += (tgt[ix] - pos[ix]) * k; vel[iy] += (tgt[iy] - pos[iy]) * k;
						const dx = pos[ix] - mx, dy = pos[iy] - my, d2 = dx * dx + dy * dy;
						if (d2 < R2) { const f = (1 - d2 / R2) * 6; const inv = 1 / Math.sqrt(d2 + 1); vel[ix] += dx * inv * f; vel[iy] += dy * inv * f; }
						vel[ix] *= 0.86; vel[iy] *= 0.86;
						pos[ix] += vel[ix]; pos[iy] += vel[iy];
					}
					gl.bindBuffer(gl.ARRAY_BUFFER, bp); gl.bufferSubData(gl.ARRAY_BUFFER, 0, pos);
					gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
					gl.uniform2f(uR, W, H); gl.uniform1f(uD, dpr);
					gl.drawArrays(gl.POINTS, 0, N);
					requestAnimationFrame(frame);
				}
				document.fonts.ready.then(() => {
					resize(); addEventListener('resize', resize);
					if (!reduced) setInterval(retarget, 4200);
					frame();
				});
			}
		</script>
	</body>
</html>
