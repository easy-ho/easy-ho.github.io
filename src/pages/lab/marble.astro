---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const holes = posts.map((p, i) => { const a = -Math.PI / 2 + (i * 2 * Math.PI) / posts.length; return { x: Math.cos(a) * 5.5, z: Math.sin(a) * 5.5, title: p.data.title, date: fmt(p.data.pubDate), href: `/blog/${p.id}/` }; });
// 장애물 언덕 (x, z, 높이, 폭)
const bumps = [[0, 0, 1.1, 1.6], [3.2, 3.0, 0.7, 1.1], [-3.4, 2.6, 0.8, 1.2], [3.0, -3.3, 0.6, 1.0], [-2.8, -3.2, 0.9, 1.3], [6.5, 0.5, 0.5, 0.9]];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`marble · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			html, body { height: 100%; overflow: hidden; background: #f3e9df; }
			#gl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
			.hud { position: fixed; inset: 0; pointer-events: none; color: #4a3f3a; }
			.hud .top { position: absolute; top: calc(1.2rem + env(safe-area-inset-top, 0px)); left: 1.25rem; right: 1.25rem; display: flex; justify-content: space-between; align-items: baseline; pointer-events: auto; }
			.hud .brand { font-weight: 700; text-decoration: none; font-size: 1.05rem; color: inherit; }
			.hud .links { display: flex; gap: 1.2em; font-size: 0.95rem; } .hud .links a { text-decoration: none; color: inherit; opacity: 0.7; }
			.intro { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; transition: opacity 0.5s; pointer-events: auto; cursor: pointer; }
			.intro h1 { font-size: clamp(2.4rem, 7vw, 4rem); letter-spacing: -0.03em; margin: 0 0 0.2em; font-weight: 800; }
			.intro p { margin: 0; opacity: 0.75; }
			.intro .go { margin-top: 2em; font-family: var(--mono); font-size: 0.85rem; opacity: 0.8; animation: pulse 1.6s ease-in-out infinite; }
			@keyframes pulse { 50% { opacity: 0.3; } }
			.intro.off { opacity: 0; pointer-events: none; }
			.near { position: absolute; left: 50%; top: 14%; transform: translateX(-50%); text-align: center; opacity: 0; transition: opacity 0.3s; white-space: nowrap; }
			.near.on { opacity: 1; }
			.near .t { font-size: clamp(1.1rem, 3vw, 1.6rem); font-weight: 800; letter-spacing: -0.02em; }
			.near .d { font-family: var(--mono); font-size: 0.8rem; opacity: 0.7; margin-top: 0.2em; }
			.help { position: absolute; left: 1.25rem; bottom: calc(1.2rem + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 0.78rem; opacity: 0.6; }
			.fallback { max-width: 660px; margin: 4rem auto; padding: 0 1.25rem; display: none; }
		</style>
	</head>
	<body>
		<canvas id="gl"></canvas>
		<div class="hud" id="hud">
			<div class="top"><a class="brand" href="/">{SITE_TITLE}</a><div class="links"><a href="/blog">글</a><a href="/about">소개</a></div></div>
			<div class="intro" id="intro"><div><h1>easyho.log</h1><p>세계를 기울여 구슬을 굴린다. 구멍 하나가 글 하나.</p><div class="go" id="go">눌러서 시작</div></div></div>
			<div class="near" id="near"><div class="t" id="nt"></div><div class="d" id="nd"></div></div>
			<div class="help" id="help">마우스를 움직이면 세계가 기운다</div>
		</div>
		<div class="fallback" id="fallback"><ul class="post-list">{holes.map((m) => <li><span>{m.date}</span><a href={m.href}>{m.title}</a></li>)}</ul></div>
		<script define:vars={{ holes, bumps }}>
			const canvas = document.getElementById('gl');
			const gl = canvas.getContext('webgl2', { antialias: false, alpha: false });
			if (!gl) { document.getElementById('fallback').style.display = 'block'; document.getElementById('hud').style.display = 'none'; canvas.remove(); document.body.style.overflow = 'auto'; }
			else {
				const L = 9, NB = bumps.length, NH = holes.length, HR = 0.75, MR = 0.42;
				const vs = `#version 300 es
				void main(){ vec2 v = vec2((gl_VertexID<<1)&2, gl_VertexID&2); gl_Position = vec4(v*2.-1.,0.,1.); }`;
				const fs = `#version 300 es
				precision highp float; out vec4 o;
				uniform vec2 R; uniform float T; uniform vec2 TILT; uniform vec3 BALL; uniform int NEAR; uniform vec4 BUMP[${NB}]; uniform vec2 HOLE[${NH}];
				const float L = ${L}.0, HR = ${HR}, MR = ${MR};
				float height(vec2 p){
					float h = TILT.x*p.x + TILT.y*p.y;
					for(int i=0;i<${NB};i++){ vec2 d = p - BUMP[i].xy; h += BUMP[i].z * exp(-dot(d,d)/(BUMP[i].w*BUMP[i].w)); }
					for(int i=0;i<${NH};i++){ float d = length(p - HOLE[i]); h -= 0.9 * smoothstep(HR+0.35, HR*0.4, d); }
					vec2 e = max(abs(p) - (L - 1.2), 0.); h += 0.9 * dot(e,e);
					return h;
				}
				float sdSphere(vec3 p, vec3 c, float r){ return length(p-c)-r; }
				vec2 map(vec3 p){ float t = (p.y - height(p.xz)) * 0.55; float s = sdSphere(p, BALL, MR); return t < s ? vec2(t, 0.) : vec2(s, 1.); }
				vec3 normal(vec3 p){ vec2 e=vec2(2e-3,0.); return normalize(vec3(map(p+e.xyy).x-map(p-e.xyy).x, map(p+e.yxy).x-map(p-e.yxy).x, map(p+e.yyx).x-map(p-e.yyx).x)); }
				float shadow(vec3 ro, vec3 rd){ float r=1., t=0.08; for(int i=0;i<24;i++){ float h=map(ro+rd*t).x; if(h<1e-3) return 0.; r=min(r, 10.*h/t); t+=clamp(h,0.06,0.5); if(t>8.) break; } return clamp(r,0.,1.); }
				void main(){
					vec2 uv = (gl_FragCoord.xy*2.-R)/R.y;
					vec3 ro = BALL*vec3(0.35,0.,0.35) + vec3(0., 11.5, -9.5);
					vec3 ta = BALL*vec3(0.35,0.,0.35) + vec3(0., 0., 0.8);
					vec3 f = normalize(ta-ro), r = normalize(cross(vec3(0,1,0), f)), u = cross(f, r);
					vec3 rd = normalize(uv.x*r + uv.y*u + 2.1*f);
					float t=0.; vec2 m; bool hit=false;
					for(int i=0;i<90;i++){ m = map(ro+rd*t); if(m.x<1e-3){ hit=true; break; } if(t>40.) break; t += m.x; }
					vec3 bg = vec3(0.95,0.91,0.86);
					vec3 col = bg;
					if (hit) {
						vec3 p = ro+rd*t, n = normal(p);
						vec3 Ld = normalize(vec3(-0.5, 0.8, -0.4));
						float dif = clamp(dot(n,Ld),0.,1.);
						float sh = shadow(p + n*0.01, Ld);
						vec3 base;
						if (m.y < 0.5) {
							float h = height(p.xz) - (TILT.x*p.x + TILT.y*p.y);
							vec3 low = vec3(0.86,0.78,0.72), mid = vec3(0.76,0.66,0.62), top = vec3(0.98,0.84,0.6);
							base = mix(low, top, smoothstep(0.0, 1.0, h)); base = mix(base, mid, smoothstep(-0.2,-0.9,h));
							// 구멍
							for(int i=0;i<${NH};i++){ float d = length(p.xz - HOLE[i]); vec3 hc = i==NEAR ? vec3(0.95,0.55,0.35) : vec3(0.28,0.2,0.22); base = mix(base, hc, smoothstep(HR*0.55, HR*0.4, d)); base = mix(base, vec3(0.98,0.9,0.75), smoothstep(0.06,0.0,abs(d-HR*0.62))*0.8); }
							// 바닥 격자
							vec2 g = abs(fract(p.xz)-0.5); base = mix(base, base*0.94, smoothstep(0.03,0.0,min(g.x,g.y)));
							base = mix(base, bg, smoothstep(L-1.4, L, max(abs(p.x),abs(p.z)))*0.5);
						} else {
							base = vec3(0.93,0.33,0.3);
							float sp = pow(clamp(dot(reflect(-Ld, n), -rd),0.,1.), 40.); base += sp*0.6;
						}
						col = base*(0.45 + 0.55*dif*mix(0.35,1.,sh));
						col = mix(col, bg, smoothstep(14., 30., t));
					}
					col *= 1. - 0.12*dot(uv*0.5, uv*0.5);
					o = vec4(col, 1.);
				}`;
				const prog = gl.createProgram();
				for (const [type, src] of [[gl.VERTEX_SHADER, vs], [gl.FRAGMENT_SHADER, fs]]) { const sh = gl.createShader(type); gl.shaderSource(sh, src); gl.compileShader(sh); if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(sh)); gl.attachShader(prog, sh); }
				gl.linkProgram(prog); gl.useProgram(prog);
				const U = (n) => gl.getUniformLocation(prog, n);
				gl.uniform4fv(U('BUMP'), new Float32Array(bumps.flat())); gl.uniform2fv(U('HOLE'), new Float32Array(holes.flatMap((h) => [h.x, h.z])));
				const scale = Math.min(devicePixelRatio, 2) * (innerWidth < 700 ? 0.45 : 0.55);
				function resize() { canvas.width = Math.floor(innerWidth * scale); canvas.height = Math.floor(innerHeight * scale); gl.viewport(0, 0, canvas.width, canvas.height); }
				addEventListener('resize', resize); resize();
				// 셰이더와 같은 높이 함수 (기울기는 물리에서 따로 더함)
				const sm = (a, b, x) => { const t = Math.max(0, Math.min(1, (x - a) / (b - a))); return t * t * (3 - 2 * t); };
				function hgt(x, z) {
					let h = 0;
					for (const [bx, bz, bh, bw] of bumps) { const dx = x - bx, dz = z - bz; h += bh * Math.exp(-(dx * dx + dz * dz) / (bw * bw)); }
					for (const ho of holes) { const d = Math.hypot(x - ho.x, z - ho.z); h -= 0.9 * sm(HR + 0.35, HR * 0.4, d); }
					const ex = Math.max(Math.abs(x) - (L - 1.2), 0), ez = Math.max(Math.abs(z) - (L - 1.2), 0); h += 0.9 * (ex * ex + ez * ez);
					return h;
				}
				const ball = { x: 0, z: -3.2, vx: 0, vz: 0 }, tilt = { x: 0, y: 0 }, want = { x: 0, y: 0 };
				let started = false, near = -1, falling = -1, fallT = 0;
				const intro = document.getElementById('intro'), nearEl = document.getElementById('near'), nt = document.getElementById('nt'), nd = document.getElementById('nd'), help = document.getElementById('help');
				const coarse = matchMedia('(pointer: coarse)').matches;
				function start() { started = true; intro.classList.add('off'); if (coarse) help.textContent = '폰을 기울이면 세계가 기운다'; }
				intro.addEventListener('click', () => {
					const D = window.DeviceOrientationEvent;
					if (coarse && D && typeof D.requestPermission === 'function') D.requestPermission().then((s) => { if (s === 'granted') addEventListener('deviceorientation', gyro); start(); });
					else { if (coarse && D) addEventListener('deviceorientation', gyro); start(); }
				});
				addEventListener('pointermove', (e) => { if (coarse) return; want.x = (e.clientX / innerWidth - 0.5) * 0.5; want.y = -(e.clientY / innerHeight - 0.5) * 0.5; });
				function gyro(e) { want.x = Math.max(-0.3, Math.min(0.3, (e.gamma ?? 0) / 90)); want.y = Math.max(-0.3, Math.min(0.3, -((e.beta ?? 40) - 40) / 90)); }
				let last = performance.now(), t0 = last;
				function step(dt) {
					tilt.x += (want.x - tilt.x) * Math.min(1, dt * 6); tilt.y += (want.y - tilt.y) * Math.min(1, dt * 6);
					if (falling >= 0) { fallT += dt; if (fallT > 0.7) location.href = holes[falling].href; return; }
					if (!started) return;
					const e = 0.05;
					const gx = (hgt(ball.x + e, ball.z) - hgt(ball.x - e, ball.z)) / (2 * e) + tilt.x;
					const gz = (hgt(ball.x, ball.z + e) - hgt(ball.x, ball.z - e)) / (2 * e) + tilt.y;
					ball.vx -= gx * 14 * dt; ball.vz -= gz * 14 * dt;
					ball.vx *= Math.pow(0.5, dt * 0.9); ball.vz *= Math.pow(0.5, dt * 0.9);
					ball.x += ball.vx * dt; ball.z += ball.vz * dt;
					const lim = L - 0.5; if (Math.abs(ball.x) > lim) { ball.x = Math.sign(ball.x) * lim; ball.vx *= -0.4; } if (Math.abs(ball.z) > lim) { ball.z = Math.sign(ball.z) * lim; ball.vz *= -0.4; }
					let best = -1, bd = 2.4;
					holes.forEach((h, i) => { const d = Math.hypot(ball.x - h.x, ball.z - h.z); if (d < bd) { bd = d; best = i; } });
					if (best !== near) { near = best; nearEl.classList.toggle('on', near >= 0); if (near >= 0) { nt.textContent = holes[near].title; nd.textContent = holes[near].date; } }
					if (near >= 0 && bd < HR * 0.5 && Math.hypot(ball.vx, ball.vz) < 5) { falling = near; fallT = 0; }
				}
				function frame(now) {
					const dt = Math.min(0.05, (now - last) / 1000); last = now; step(dt);
					const y = hgt(ball.x, ball.z) + tilt.x * ball.x + tilt.y * ball.z + MR - (falling >= 0 ? fallT * 3 : 0);
					gl.uniform2f(U('R'), canvas.width, canvas.height); gl.uniform1f(U('T'), (now - t0) / 1000);
					gl.uniform2f(U('TILT'), tilt.x, tilt.y); gl.uniform3f(U('BALL'), ball.x, y, ball.z); gl.uniform1i(U('NEAR'), near);
					gl.drawArrays(gl.TRIANGLES, 0, 3); requestAnimationFrame(frame);
				}
				requestAnimationFrame(frame);
			}
		</script>
	</body>
</html>
